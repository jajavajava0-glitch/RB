<Item class="Script" referent="RBX66C1625455D04AC580D8104903513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">AdminServer</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MessagingService = game:GetService("MessagingService")
local TextService = game:GetService("TextService")

local Core = require(script.Parent:WaitForChild("GameCore"))

------------------------------------------------------------
-- CONFIG
------------------------------------------------------------
local OWNER_NAME = "jesusplay419"
local MAX_TAGS = 4
local MAX_TAG_LEN = 14
local MAX_MSG_LEN = 120
local TOPIC = "KE_GlobalMessage"

local LIMITS = { xp = 1e9, level = 1e6, wins = 1e12, rebirths = 1e6 }
local KIND_NAMES = { xp = "XP", level = "Velocidad", wins = "Wins", rebirths = "Renacimientos" }

local adminStore = DataStoreService:GetDataStore("KE_Admins_V1")
local tagStore = DataStoreService:GetDataStore("KE_Tags_V1")

local requestRF = Instance.new("RemoteFunction")
requestRF.Name = "AdminRequest"
requestRF.Parent = ReplicatedStorage

local messageRE = Instance.new("RemoteEvent")
messageRE.Name = "GlobalMessage"
messageRE.Parent = ReplicatedStorage

------------------------------------------------------------
-- ADMINS
------------------------------------------------------------
local admins = {} -- ["userId"] = "nombre"
do
local ok, result = pcall(function()
    return adminStore:GetAsync("list")
end)
if ok and type(result) == "table" then
    admins = result
end
end

local ownerId
do
local ok, id = pcall(function()
    return Players:GetUserIdFromNameAsync(OWNER_NAME)
end)
if ok then ownerId = id end
end

local function isOwner(player)
    if ownerId then
        return player.UserId == ownerId
    end
    return string.lower(player.Name) == string.lower(OWNER_NAME)
end

local function isAdmin(player)
    return isOwner(player) or admins[tostring(player.UserId)] ~= nil
end

local function updateAttrs(player)
    player:SetAttribute("IsOwner", isOwner(player))
    player:SetAttribute("IsAdmin", isAdmin(player))
end

local function saveAdmins()
    pcall(function()
        adminStore:SetAsync("list", admins)
    end)
end

local function listAdmins()
    local list = { { userId = ownerId or 0, name = OWNER_NAME, owner = true } }
    local others = {}
    for id, name in pairs(admins) do
        if tonumber(id) ~= ownerId then
            table.insert(others, { userId = tonumber(id), name = name, owner = false })
        end
    end
    table.sort(others, function(a, b)
        return string.lower(a.name) < string.lower(b.name)
    end)
    for _, e in ipairs(others) do
        table.insert(list, e)
    end
    return list
end

------------------------------------------------------------
-- UTILIDADES
------------------------------------------------------------
local function reply(ok, msg, extra)
    local r = extra or {}
    r.ok = ok
    r.msg = msg
    return r
end

local function trim(s)
    return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function findTargets(admin, text)
    local q = string.lower((tostring(text or ""):gsub("%s", "")))
    if q == "" then return {} end
    if q == "yo" or q == "me" then return { admin } end
    if q == "todos" or q == "all" then return Players:GetPlayers() end
    
    local exact, partial = {}, {}
    for _, pl in ipairs(Players:GetPlayers()) do
        local n, dn = string.lower(pl.Name), string.lower(pl.DisplayName)
        if n == q or dn == q then
            table.insert(exact, pl)
        elseif string.sub(n, 1, #q) == q or string.sub(dn, 1, #q) == q then
            table.insert(partial, pl)
        end
    end
    if #exact > 0 then return exact end
    if #partial > 0 then return { partial[1] } end
    return {}
end

local function filterText(text, fromPlayer)
    local ok, result = pcall(function()
        local obj = TextService:FilterStringAsync(text, fromPlayer.UserId)
        return obj:GetNonChatStringForBroadcastAsync()
    end)
    if ok then return result end
    return nil
end

------------------------------------------------------------
-- TAGS
------------------------------------------------------------
local tags = {} -- [player] = { {Text=, R=, G=, B=} }

local function loadTags(player)
    local ok, result = pcall(function()
        return tagStore:GetAsync("T_" .. player.UserId)
    end)
    tags[player] = (ok and type(result) == "table") and result or {}
end

local function saveTags(player)
    local list = tags[player]
    if not list then return end
    pcall(function()
        tagStore:SetAsync("T_" .. player.UserId, list)
    end)
end

local PILL_H = 26

local function applyTags(player)
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head") or char:WaitForChild("Head", 5)
    if not head then return end
    
    local old = head:FindFirstChild("AdminTags")
    if old then old:Destroy() end
    
    local list = tags[player]
    if not list or #list == 0 then return end
    
    local bb = Instance.new("BillboardGui")
    bb.Name = "AdminTags"
    bb.Adornee = head
    bb.Size = UDim2.fromOffset(240, #list * (PILL_H + 4))
    bb.StudsOffset = Vector3.new(0, 3.4, 0)
    bb.ExtentsOffset = Vector3.new(0, 0.5, 0)
    bb.MaxDistance = 80
    bb.LightInfluence = 0
    bb.AlwaysOnTop = false
    bb.Parent = head
    
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 4)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = bb
    
    for i, t in ipairs(list) do
        local color = Color3.fromRGB(t.R, t.G, t.B)
        local width = math.clamp(30 + (utf8.len(t.Text) or #t.Text) * 11, 64, 230)
        
        local pill = Instance.new("Frame")
        pill.LayoutOrder = i
        pill.Size = UDim2.fromOffset(width, PILL_H)
        pill.BackgroundColor3 = Color3.new(1, 1, 1)
        pill.Parent = bb
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0.5, 0)
        corner.Parent = pill
        
        local grad = Instance.new("UIGradient")
        grad.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.25), color:Lerp(Color3.new(0, 0, 0), 0.3))
        grad.Rotation = 90
        grad.Parent = pill
        
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(20, 24, 34)
        stroke.Thickness = 2
        stroke.Parent = pill
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.FredokaOne
        label.TextSize = 16
        label.TextColor3 = Color3.new(1, 1, 1)
        label.Text = t.Text
        label.Parent = pill
        
        local ls = Instance.new("UIStroke")
        ls.Color = color:Lerp(Color3.new(0, 0, 0), 0.6)
        ls.Thickness = 2
        ls.Parent = label
    end
end

------------------------------------------------------------
-- DAR XP / VELOCIDAD / WINS / RENACIMIENTOS
------------------------------------------------------------
local function xpPopup(player, amount)
    player:SetAttribute("XPGain", amount)
    player:SetAttribute("XPGainId", (player:GetAttribute("XPGainId") or 0) + 1)
end

local function applyGive(p, kind, amount)
    local d = Core.data[p]
    if not d then return false end
    
    if kind == "xp" then
        if amount >= 0 then
            Core.addXP(p, amount)
            xpPopup(p, amount)
        else
            d.XP = math.max(0, d.XP + amount)
            Core.refresh(p)
        end
    elseif kind == "level" then
        d.Level = math.max(0, d.Level + math.floor(amount))
        d.XP = math.min(d.XP, Core.xpNeeded(d.Level) - 1)
        Core.refresh(p)
    elseif kind == "wins" then
        d.Wins = math.max(0, d.Wins + math.floor(amount))
        Core.refresh(p)
    elseif kind == "rebirths" then
        d.Rebirths = math.max(0, d.Rebirths + math.floor(amount))
        Core.refresh(p)
    elseif kind == "reset" then
        d.XP, d.Level, d.Wins, d.Rebirths, d.Upgrades = 0, 0, 0, 0, {}
        Core.refresh(p)
    end
    return true
end

------------------------------------------------------------
-- ACCIONES DEL PANEL
------------------------------------------------------------
local handlers = {}

handlers.give = function(admin, p)
    local kind = p.kind
    if kind ~= "reset" and not LIMITS[kind] then
        return reply(false, "Tipo inválido")
    end
    
    local targets = findTargets(admin, p.target)
    if #targets == 0 then return reply(false, "Jugador no encontrado") end
    
    local amount = 0
    if kind ~= "reset" then
        amount = tonumber(p.amount)
        if not amount or amount ~= amount or amount == math.huge or amount == -math.huge or amount == 0 then
            return reply(false, "Cantidad inválida")
        end
        amount = math.clamp(amount, -LIMITS[kind], LIMITS[kind])
    end
    
    local count = 0
    for _, target in ipairs(targets) do
        if applyGive(target, kind, amount) then
            count += 1
            if target ~= admin then
                if kind == "reset" then
                    Core.notify(target, "Un admin reinició tu progreso")
                else
                    Core.notify(target, "Un admin te dio " .. amount .. " " .. KIND_NAMES[kind] .. " 🎁")
                end
            end
        end
    end
    
    if count == 0 then return reply(false, "No se pudo aplicar") end
    if kind == "reset" then
        return reply(true, "Reiniciado a " .. count .. " jugador(es) ✅")
    end
    return reply(true, "Diste " .. amount .. " " .. KIND_NAMES[kind] .. " a " .. count .. " jugador(es) ✅")
end

handlers.tag_give = function(admin, p)
    local text = trim(p.text)
    local len = utf8.len(text)
    if not len or len < 1 or len > MAX_TAG_LEN then
        return reply(false, "El tag debe tener de 1 a " .. MAX_TAG_LEN .. " letras")
    end
    
    local c = p.color
    if type(c) ~= "table" then return reply(false, "Color inválido") end
    local r = math.floor(math.clamp(tonumber(c[1]) or 255, 0, 255))
    local g = math.floor(math.clamp(tonumber(c[2]) or 255, 0, 255))
    local b = math.floor(math.clamp(tonumber(c[3]) or 255, 0, 255))
    
    local targets = findTargets(admin, p.target)
    if #targets == 0 then return reply(false, "Jugador no encontrado") end
    
    local clean = filterText(text, admin)
    if not clean or clean ~= text then return reply(false, "Texto no permitido") end
    
    local count, full = 0, 0
    for _, target in ipairs(targets) do
        local list = tags[target]
        if list then
            local existing
            for _, t in ipairs(list) do
                if string.lower(t.Text) == string.lower(text) then existing = t end
            end
            if existing then
                existing.R, existing.G, existing.B = r, g, b
                count += 1
            elseif #list >= MAX_TAGS then
                full += 1
            else
                table.insert(list, { Text = text, R = r, G = g, B = b })
                count += 1
            end
            saveTags(target)
            applyTags(target)
            if target ~= admin then
                Core.notify(target, "Recibiste el tag [" .. text .. "] 🏷️")
            end
        end
    end
    
    if count == 0 and full > 0 then
        return reply(false, "Máximo " .. MAX_TAGS .. " tags por jugador")
    end
    return reply(true, "Tag [" .. text .. "] dado a " .. count .. " jugador(es) ✅")
end

handlers.tag_remove = function(admin, p)
    local targets = findTargets(admin, p.target)
    if #targets == 0 then return reply(false, "Jugador no encontrado") end
    
    local text = string.lower(trim(p.text))
    local removed = 0
    for _, target in ipairs(targets) do
        local list = tags[target]
        if list then
            if text == "" then
                removed += #list
                tags[target] = {}
            else
                for i = #list, 1, -1 do
                    if string.lower(list[i].Text) == text then
                        table.remove(list, i)
                        removed += 1
                    end
                end
            end
            saveTags(target)
            applyTags(target)
        end
    end
    
    if removed == 0 then return reply(false, "No había tags para quitar") end
    return reply(true, "Tags quitados: " .. removed .. " ✅")
end

handlers.message = function(admin, p)
    local text = trim(p.text)
    local len = utf8.len(text)
    if not len or len < 1 then return reply(false, "Escribe un mensaje") end
    if len > MAX_MSG_LEN then return reply(false, "Máximo " .. MAX_MSG_LEN .. " caracteres") end
    
    local clean = filterText(text, admin)
    if not clean then return reply(false, "No se pudo enviar el mensaje") end
    
    if p.scope == "global" then
        local ok = pcall(function()
            MessagingService:PublishAsync(TOPIC, { text = clean })
        end)
        if ok then
            return reply(true, "Mensaje global enviado 🌍")
        end
        messageRE:FireAllClients(clean)
        return reply(true, "Global no disponible aquí, se envió a este server")
    end
    
    messageRE:FireAllClients(clean)
    return reply(true, "Mensaje enviado a este server ✅")
end

handlers.admin_list = function()
    return reply(true, nil, { admins = listAdmins() })
end

handlers.admin_add = function(admin, p)
    if not isOwner(admin) then return reply(false, "Solo el dueño puede hacer esto") end
    local name = trim(p.name)
    if name == "" then return reply(false, "Escribe un usuario") end
    
    local ok, id = pcall(function()
        return Players:GetUserIdFromNameAsync(name)
    end)
    if not ok or not id then return reply(false, "Usuario no encontrado") end
    if id == ownerId then return reply(false, "Ese es el dueño") end
    if admins[tostring(id)] then return reply(false, "Ya es admin") end
    
    admins[tostring(id)] = name
    saveAdmins()
    local online = Players:GetPlayerByUserId(id)
    if online then updateAttrs(online) end
    return reply(true, name .. " ahora es admin ✅", { admins = listAdmins() })
end

handlers.admin_remove = function(admin, p)
    if not isOwner(admin) then return reply(false, "Solo el dueño puede hacer esto") end
    local id = tonumber(p.userId)
    if not id or id == ownerId then return reply(false, "No se puede quitar") end
    if not admins[tostring(id)] then return reply(false, "No es admin") end
    
    local name = admins[tostring(id)]
    admins[tostring(id)] = nil
    saveAdmins()
    local online = Players:GetPlayerByUserId(id)
    if online then updateAttrs(online) end
    return reply(true, name .. " ya no es admin ✅", { admins = listAdmins() })
end

local lastCall = {}

requestRF.OnServerInvoke = function(player, action, payload)
    if type(action) ~= "string" then return { ok = false } end
    if type(payload) ~= "table" then payload = {} end
    if not isAdmin(player) then return { ok = false, msg = "No tienes permiso" } end
    
    local now = os.clock()
    if lastCall[player] and now - lastCall[player] < 0.15 then
        return { ok = false, msg = "Más despacio" }
    end
    lastCall[player] = now
    
    local handler = handlers[action]
    if not handler then return { ok = false } end
    
    local ok, res = pcall(handler, player, payload)
    if not ok then
        warn("AdminServer error: " .. tostring(res))
        return { ok = false, msg = "Error del servidor" }
    end
    return res
end

------------------------------------------------------------
-- MENSAJES GLOBALES (entre servers)
------------------------------------------------------------
task.spawn(function()
    pcall(function()
        MessagingService:SubscribeAsync(TOPIC, function(message)
            local data = message.Data
            if type(data) == "table" and type(data.text) == "string" then
                messageRE:FireAllClients(data.text)
            end
        end)
    end)
end)

------------------------------------------------------------
-- JUGADORES
------------------------------------------------------------
local function setupPlayer(player)
    updateAttrs(player)
    task.spawn(function()
        loadTags(player)
        applyTags(player)
    end)
    player.CharacterAdded:Connect(function()
        task.spawn(applyTags, player)
    end)
end

Players.PlayerAdded:Connect(setupPlayer)
for _, p in ipairs(Players:GetPlayers()) do
    setupPlayer(p)
end

Players.PlayerRemoving:Connect(function(player)
    tags[player] = nil
    lastCall[player] = nil
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8049040041fa</UniqueId>
</Properties>
