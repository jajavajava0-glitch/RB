<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">XPPopups</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local UI = require(script.Parent:WaitForChild("UI"))
 
------------------------------------------------------------
-- ★ AQUI CAMBIAS COLOR, TAMAÑO Y LETRA ★
------------------------------------------------------------
local STYLE = {
ICON = "👟",                                    -- emoji junto al numero ("" para quitarlo)
TEXT_COLOR = Color3.fromRGB(255, 225, 90),      -- color del numero (dorado)
OUTLINE = Color3.fromRGB(60, 35, 0),            -- contorno
OUTLINE_THICKNESS = 3,
FONT = Enum.Font.FredokaOne,                    -- otras: LuckiestGuy, Bangers, Cartoon
SIZE_MIN = 20,                                  -- tamaño mas chico
SIZE_MAX = 26,                                  -- tamaño mas grande
COUNT = 3,                                      -- cuantos salen (1 a 3)
}
 
-- Lugares donde salen (X, Y en pantalla; 0.5 es el centro)
local SLOTS = {
{ 0.40, 0.38 },
{ 0.60, 0.50 },
{ 0.42, 0.62 },
}
------------------------------------------------------------
 
local player = Players.LocalPlayer
local root = UI.root
 
local function rnd(a, b)
    return a + math.random() * (b - a)
end
 
local function fmt(n)
    local suffixes = {
    { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" },
    }
    for _, s in ipairs(suffixes) do
        if n >= s[1] then
            local v = string.format("%.2f", n / s[1])
            v = v:gsub("%.?0+$", "")
            return v .. s[2]
        end
    end
    if n >= 100 then
        return tostring(math.floor(n))
    end
    local s = string.format("%.1f", n)
    s = s:gsub("%.0$", "")
    return s
end
 
local function popup(text, x, y)
    local lbl = Instance.new("TextLabel")
    lbl.AnchorPoint = Vector2.new(0.5, 0.5)
    lbl.Position = UDim2.new(x, 0, y, 0)
    lbl.Size = UDim2.fromOffset(200, 40)
    lbl.BackgroundTransparency = 1
    lbl.Font = STYLE.FONT
    lbl.TextSize = math.floor(rnd(STYLE.SIZE_MIN, STYLE.SIZE_MAX))
    lbl.TextColor3 = STYLE.TEXT_COLOR
    lbl.Text = text
    lbl.Rotation = rnd(-6, 6)
    lbl.ZIndex = 60
    lbl.Parent = root
    
    local stroke = UI.textStroke(lbl, STYLE.OUTLINE, STYLE.OUTLINE_THICKNESS)
    
    local scale = Instance.new("UIScale")
    scale.Scale = 0.4
    scale.Parent = lbl
    UI.tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
    
    task.delay(0.3, function()
        UI.tween(lbl, 0.6, {
        Position = lbl.Position - UDim2.fromOffset(0, 40),
        TextTransparency = 1,
        })
        UI.tween(stroke, 0.6, { Transparency = 1 })
        task.delay(0.7, function()
            lbl:Destroy()
        end)
    end)
end
 
local lastId = player:GetAttribute("XPGainId") or 0
 
player:GetAttributeChangedSignal("XPGainId"):Connect(function()
    local id = player:GetAttribute("XPGainId") or 0
    if id == lastId then return end
    lastId = id
    
    local amount = player:GetAttribute("XPGain") or 0
    if amount <= 0 then return end
    
    local text = (STYLE.ICON ~= "" and (STYLE.ICON .. " ") or "") .. "+" .. fmt(amount)
    
    for i = 1, math.clamp(STYLE.COUNT, 1, #SLOTS) do
        local slot = SLOTS[i]
        popup(text, slot[1] + rnd(-0.03, 0.03), slot[2] + rnd(-0.03, 0.03))
    end
end)

]]></ProtectedString>
