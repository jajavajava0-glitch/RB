<Item class="Script" referent="RBX66C1625455D04AC580D8101135513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local part = script.Parent
local tweenService = game:GetService("TweenService")
local sound = part:FindFirstChild("Sound")

local originalPosition = part.Position
local upPosition = originalPosition + Vector3.new(0, 100, 0)

local tweenInfo = TweenInfo.new(10, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)

local upTween = tweenService:Create(part, tweenInfo, {Position = upPosition})
local downTween = tweenService:Create(part, tweenInfo, {Position = originalPosition})

local function showWarningForNearbyPlayers()
    for _, player in ipairs(game.Players:GetPlayers()) do
        local character = player.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local hrp = character.HumanoidRootPart
            if (hrp.Position - part.Position).Magnitude <= 15 then
                local playerGui = player:FindFirstChild("PlayerGui")
                if playerGui and not playerGui:FindFirstChild("TrapWarningGui") then
                    local screenGui = Instance.new("ScreenGui")
                    screenGui.Name = "TrapWarningGui"
                    screenGui.ResetOnSpawn = false
                    
                    local textLabel = Instance.new("TextLabel")
                    textLabel.Name = "WarningText"
                    textLabel.Size = UDim2.new(0, 400, 0, 80)
                    textLabel.Position = UDim2.new(0.5, -200, 0.15, 0)
                    textLabel.BackgroundTransparency = 0.5
                    textLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    textLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
                    textLabel.TextScaled = true
                    textLabel.Font = Enum.Font.FredokaOne
                    textLabel.Text = "¡ADVERTENCIA: PELIGRO ACTIVÁNDOSE!"
                    textLabel.Parent = screenGui
                    
                    screenGui.Parent = playerGui
                    
                    task.delay(4, function()
                        if screenGui then
                            screenGui:Destroy()
                        end
                    end)
                end
            end
        end
    end
end

part.Touched:Connect(function(hit)
    local character = hit.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.Health = 0
    end
end)

while true do
    showWarningForNearbyPlayers()
    task.wait(1)
    
    if sound then
        sound:Play()
    end
    
    upTween:Play()
    upTween.Completed:Wait()
    
    task.wait(2)
    
    downTween:Play()
    downTween.Completed:Wait()
    
    task.wait(5)
end




]]></ProtectedString>
