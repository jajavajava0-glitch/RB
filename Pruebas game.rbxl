<Item class="Script" referent="RBX66C1625455D04AC580D8104905513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Rebirth</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Core = require(script.Parent:WaitForChild("GameCore"))
local MarketplaceService = game:GetService("MarketplaceService")
 
local CONFIG = Core.CONFIG
local data = Core.data
 
-- Boton RENACER
Core.rebirthRemote.OnServerEvent:Connect(function(player)
    local d = data[player]
    if not d then return end
    local need = Core.rebirthLevelNeeded(d.Rebirths)
    if d.Level < need then
        Core.notify(player, "Necesitas nivel " .. need .. " para renacer")
        return
    end
    Core.doRebirth(player)
end)
 
-- Boton SALTAR RENACIMIENTO (Robux). La compra la procesa el script Shop.
Core.skipRemote.OnServerEvent:Connect(function(player)
    if CONFIG.SkipRebirthProductId == 0 then
        Core.notify(player, "Próximamente")
        return
    end
    MarketplaceService:PromptProductPurchase(player, CONFIG.SkipRebirthProductId)
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8049060041fa</UniqueId>
