<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Workspace = game:GetService("Workspace")

local spawnPart = Workspace:WaitForChild("Spawn")
local despawnPart = Workspace:WaitForChild("Despawn")
local startPart = Workspace:WaitForChild("Start") -- Buscamos la pieza Start para el teletransporte

local function iniciarCiclo()
    while true do
        -- 1. Creamos la bola
        local ball = Instance.new("Part")
        ball.Name = "bola"
        ball.Shape = Enum.PartType.Ball
        ball.Size = Vector3.new(15.736, 15.736, 15.736)
        ball.Position = spawnPart.Position + Vector3.new(0, 3, 0)
        ball.Material = Enum.Material.SmoothPlastic
        ball.Color = Color3.fromRGB(0, 170, 255)
        ball.Anchored = false
        
        -- Hacemos que la bola sea muy pesada (CustomPhysicalProperties) para que los jugadores no la puedan empujar fácilmente
        ball.CustomPhysicalProperties = PhysicalProperties.new(
        100,  -- Densidad alta (pesada para que no la muevan los avatares, pero la gravedad la hace bajar)
        0.3,  -- Fricción
        0.5,  -- Elasticidad
        1,    -- Fricción de fricción
        1     -- Elasticidad de fricción
        )
        
        ball.Parent = Workspace
        
        local destruida = false
        
        -- 2. Detectar si un jugador toca la bola para teletransportarlo a "Start"
        local conexionToqueJugador
        conexionToqueJugador = ball.Touched:Connect(function(hit)
            local character = hit.Parent
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            
            -- Verificamos si lo que tocó la bola es un jugador (tiene un Humanoid y un RootPart)
            if humanoid then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if rootPart and startPart then
                    -- Teletransportamos al jugador a la posición de la pieza Start (un poco más arriba para que no se atasque)
                    rootPart.CFrame = startPart.CFrame + Vector3.new(0, 3, 0)
                end
            end
        end)
        
        -- 3. Detectamos cuando toca el Despawn
        local conexionDespawn
        conexionDespawn = despawnPart.Touched:Connect(function(hit)
            if hit == ball and not destruida then
                destruida = true
                if conexionDespawn then conexionDespawn:Disconnect() end
                if conexionToqueJugador then conexionToqueJugador:Disconnect() end
                ball:Destroy()
            end
        end)
        
        -- 4. Esperamos a que la bola sea destruida (o damos un tiempo máximo de 12 segundos)
        local tiempoTranscurrido = 0
        while ball and ball.Parent and not destruida and tiempoTranscurrido < 12 do
            task.wait(0.2)
            tiempoTranscurrido = tiempoTranscurrido + 0.2
        end
        
        -- Si por alguna razón seguía viva, la borramos y limpiamos conexiones
        if ball and ball.Parent then
            if conexionDespawn then conexionDespawn:Disconnect() end
            if conexionToqueJugador then conexionToqueJugador:Disconnect() end
            ball:Destroy()
        end
        
        -- 5. Pausa de 5 segundos antes de repetir el ciclo
        task.wait(5)
    end
end

-- Iniciamos el ciclo
task.spawn(iniciarCiclo)

]]></ProtectedString>
