<Item class="Script" referent="RBX66C1625455D04AC580D8100631513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local parte = script.Parent

while true do
    -- 1. Se muestra y activa las colisiones (aparece)
    
    parte.Transparency = 0
    parte.CanCollide = true
    
    -- 2. Se queda visible durante 10 segundos
    
    task.wait(10)
    
    -- 3. Se oculta y desactiva las colisiones (desaparece)
    
    parte.Transparency = 1
    parte.CanCollide = false
    
    -- 4. Se queda invisible/desactivada durante 5 segundos
    
    task.wait(5)
end






]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8006320041fa</UniqueId>
