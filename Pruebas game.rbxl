<string name="Name">AdminCore</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UI = require(script.Parent:WaitForChild("UI"))

local player = Players.LocalPlayer
local requestRF = ReplicatedStorage:WaitForChild("AdminRequest")

local new, tween, corner, border = UI.new, UI.tween, UI.corner, UI.border
local textStroke, gradient, makeButton = UI.textStroke, UI.gradient, UI.makeButton
local WHITE, GOLD, FONT = UI.WHITE, UI.GOLD, UI.FONT
local root = UI.root

local LINE = Color3.fromRGB(20, 24, 34)

local Admin = {}
Admin.LINE = LINE
Admin.COLORS = {
GREEN = UI.COLORS.GREEN,
RED = UI.COLORS.RED,
YELLOW = UI.COLORS.YELLOW,
PURPLE = UI.COLORS.PURPLE,
BLUE = { Color3.fromRGB(100, 190, 255), Color3.fromRGB(40, 110, 230) },
ORANGE = { Color3.fromRGB(255, 190, 70), Color3.fromRGB(240, 120, 20) },
GRAY = { Color3.fromRGB(110, 118, 140), Color3.fromRGB(62, 68, 90) },
}

function Admin.isOwner()
    return player:GetAttribute("IsOwner") == true
end

function Admin.request(action, payload)
    local ok, res = pcall(function()
        return requestRF:InvokeServer(action, payload or {})
    end)
    if not ok or type(res) ~= "table" then
        UI.showToast("Error de conexión")
        return { ok = false }
    end
    if res.msg then UI.showToast(res.msg) end
    return res
end

function Admin.makeBox(parent, placeholder, size, position, multiline)
    local box = new("TextBox", {
    Size = size,
    Position = position,
    BackgroundColor3 = Color3.fromRGB(26, 30, 40),
    PlaceholderText = placeholder,
    PlaceholderColor3 = Color3.fromRGB(130, 138, 160),
    Text = "",
    TextColor3 = WHITE,
    Font = FONT,
    TextSize = 20,
    ClearTextOnFocus = false,
    TextXAlignment = Enum.TextXAlignment.Left,
    TextYAlignment = multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
    MultiLine = multiline or false,
    TextWrapped = multiline or false,
    }, parent)
    corner(box, 10)
    border(box, LINE, 3)
    new("UIPadding", {
    PaddingLeft = UDim.new(0, 12),
    PaddingRight = UDim.new(0, 12),
    PaddingTop = UDim.new(0, multiline and 8 or 0),
    }, box)
    return box
end

function Admin.makeLabel(parent, text, size, position, textSize, color, xAlign)
    local l = new("TextLabel", {
    Size = size,
    Position = position,
    BackgroundTransparency = 1,
    Font = FONT,
    TextSize = textSize or 18,
    TextColor3 = color or WHITE,
    Text = text,
    TextWrapped = true,
    RichText = true,
    TextXAlignment = xAlign or Enum.TextXAlignment.Left,
    }, parent)
    textStroke(l, LINE, 2)
    return l
end

-- Tag bonito (se usa en la vista previa)
function Admin.makePill(parent, text, color, height)
    height = height or 30
    local width = math.clamp(30 + (utf8.len(text) or #text) * 12, 70, 230)
    local pill = new("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(width, height),
    BackgroundColor3 = WHITE,
    }, parent)
    corner(pill, height / 2)
    border(pill, LINE, 3)
    gradient(pill, { color:Lerp(WHITE, 0.25), color:Lerp(Color3.new(0, 0, 0), 0.3) })
    local l = new("TextLabel", {
    Size = UDim2.fromScale(1, 1),
    BackgroundTransparency = 1,
    Font = FONT,
    TextSize = height - 12,
    TextColor3 = WHITE,
    Text = text,
    }, pill)
    textStroke(l, color:Lerp(Color3.new(0, 0, 0), 0.6), 2)
    return pill
end

------------------------------------------------------------
-- PANEL
------------------------------------------------------------
local panel = new("Frame", {
Name = "AdminPanel",
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromScale(0.5, 0.5),
Size = UDim2.fromOffset(600, 440),
BackgroundColor3 = Color3.fromRGB(58, 62, 74),
Visible = false,
ZIndex = 30,
}, root)
corner(panel, 24)
border(panel, LINE, 5)
local panelScale = new("UIScale", { Scale = 1 }, panel)
Admin.panel = panel

-- Encabezado
local header = new("Frame", {
Position = UDim2.fromOffset(12, 10),
Size = UDim2.fromOffset(576, 62),
BackgroundColor3 = WHITE,
ZIndex = 2,
}, panel)
corner(header, 18)
border(header, LINE, 4)
gradient(header, { Color3.fromRGB(90, 205, 255), Color3.fromRGB(30, 125, 235) })

local title = new("TextLabel", {
Size = UDim2.fromScale(1, 1),
BackgroundTransparency = 1,
Font = UI.TITLE_FONT,
TextSize = 40,
TextColor3 = WHITE,
Text = "Admin Panel",
ZIndex = 3,
}, header)
textStroke(title, LINE, 5)

new("TextLabel", {
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromOffset(536, 38),
Size = UDim2.fromOffset(56, 56),
BackgroundTransparency = 1,
TextSize = 40,
Text = "⚒️",
ZIndex = 6,
}, panel)

local closeBtn = makeButton(panel, {
Name = "Close",
Size = UDim2.fromOffset(46, 46),
Position = UDim2.fromOffset(44, 41),
Colors = Admin.COLORS.RED,
Radius = 12, TextSize = 28, Text = "X", ZIndex = 6,
})

-- Contenido
local content = new("Frame", {
Position = UDim2.fromOffset(14, 126),
Size = UDim2.fromOffset(572, 284),
BackgroundColor3 = Color3.fromRGB(36, 40, 50),
ZIndex = 2,
}, panel)
corner(content, 16)
border(content, LINE, 4)
Admin.content = content

Admin.makeLabel(panel, "Admin Panel v1.0", UDim2.fromOffset(600, 22), UDim2.fromOffset(0, 414), 15,
Color3.fromRGB(150, 158, 180), Enum.TextXAlignment.Center)

-- Pestanas
local tabInfo = {
{ key = "Dar", text = "⚙️ Dar", color = Admin.COLORS.GREEN },
{ key = "Tags", text = "🏷️ Tags", color = Admin.COLORS.BLUE },
{ key = "Mensajes", text = "💬 Mensajes", color = Admin.COLORS.PURPLE },
{ key = "Admins", text = "👑 Admins", color = Admin.COLORS.ORANGE },
}

Admin.pages = {}
Admin.tabOpened = {}
local tabButtons = {}

for _, t in ipairs(tabInfo) do
    Admin.pages[t.key] = new("Frame", {
    Name = t.key,
    Size = UDim2.fromScale(1, 1),
    BackgroundTransparency = 1,
    Visible = false,
    }, content)
end

local function selectTab(key)
    for _, t in ipairs(tabInfo) do
        local selected = t.key == key
        Admin.pages[t.key].Visible = selected
        local btn = tabButtons[t.key]
        btn:FindFirstChildOfClass("UIStroke").Color = selected and WHITE or LINE
        btn.Label.TextTransparency = selected and 0 or 0.4
    end
    local f = Admin.tabOpened[key]
    if f then task.spawn(f) end
end

for i, t in ipairs(tabInfo) do
    local btn = makeButton(panel, {
    Name = "Tab" .. t.key,
    Size = UDim2.fromOffset(136, 38),
    Position = UDim2.fromOffset(86 + 143 * (i - 1), 103),
    Colors = t.color,
    Radius = 12, TextSize = 20, Text = t.text, ZIndex = 4,
    })
    tabButtons[t.key] = btn
    btn.MouseButton1Click:Connect(function()
        selectTab(t.key)
    end)
end

-- Abrir / cerrar
local isOpen = false

function Admin.open()
    isOpen = true
    panelScale.Scale = 0.7
    panel.Visible = true
    tween(panelScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
end

function Admin.close()
    isOpen = false
    tween(panelScale, 0.15, { Scale = 0.7 })
    task.delay(0.15, function()
        if not isOpen then panel.Visible = false end
    end)
end

closeBtn.MouseButton1Click:Connect(Admin.close)

-- Boton del martillo (solo admins), arriba a la derecha
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local hammer, hammerLabel = makeButton(root, {
Name = "AdminHammer",
Size = UDim2.fromOffset(64, 64),
Position = UDim2.new(1, -50, 0, 70),
Colors = { Color3.fromRGB(255, 225, 110), Color3.fromRGB(240, 140, 20) },
Radius = 16, TextSize = 36, Text = "⚒️", ZIndex = 20,
TextStrokeThickness = 0,
})
if Config.assetId(Config.Icons.Hammer) then
    -- si pusiste el ID de tu martillo: se ve solo la imagen, sin fondo
    hammer.BackgroundTransparency = 1
    hammer:FindFirstChildOfClass("UIStroke").Enabled = false
    hammerLabel.Text = ""
    Config.addIcon(hammer, "Hammer", "⚒️", UDim2.fromScale(1, 1), UDim2.fromScale(0.5, 0.5), 5)
end
hammer.Visible = false
Admin.hammer = hammer

hammer.MouseButton1Click:Connect(function()
    if isOpen then Admin.close() else Admin.open() end
end)

local function refreshAdmin()
    local isAdmin = player:GetAttribute("IsAdmin") == true
    hammer.Visible = isAdmin
    if not isAdmin and panel.Visible then
        Admin.close()
    end
end
player:GetAttributeChangedSignal("IsAdmin"):Connect(refreshAdmin)
refreshAdmin()

selectTab("Dar")

return Admin

]]></ProtectedString>
