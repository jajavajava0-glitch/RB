<Content name="LinkedSource"><null></null></Content>
<string name="Name">UI</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
 
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
 
local NAVY = Color3.fromRGB(18, 32, 92)
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 226, 90)
local FONT = Enum.Font.FredokaOne
 
local COLORS = {
RED = { Color3.fromRGB(255, 105, 105), Color3.fromRGB(210, 38, 58) },
GREEN = { Color3.fromRGB(120, 240, 95), Color3.fromRGB(38, 178, 58) },
YELLOW = { Color3.fromRGB(255, 232, 90), Color3.fromRGB(255, 170, 0) },
PURPLE = { Color3.fromRGB(190, 120, 255), Color3.fromRGB(120, 50, 215) },
DARK = { Color3.fromRGB(72, 82, 135), Color3.fromRGB(34, 40, 84) },
}
 
local function tween(obj, time, props, style, dir)
    local t = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end
 
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do
        o[k] = v
    end
    if parent then o.Parent = parent end
    return o
end
 
local function corner(o, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r) }, o)
end
 
local function border(o, color, th)
    return new("UIStroke", {
    Color = color, Thickness = th,
    ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    LineJoinMode = Enum.LineJoinMode.Round,
    }, o)
end
 
local function textStroke(o, color, th)
    return new("UIStroke", {
    Color = color, Thickness = th,
    ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
    LineJoinMode = Enum.LineJoinMode.Round,
    }, o)
end
 
local function gradient(o, pair)
    return new("UIGradient", { Color = ColorSequence.new(pair[1], pair[2]), Rotation = 90 }, o)
end
 
local function abbr(n)
    if n >= 1e9 then return string.format("%.1fB", n / 1e9)
    elseif n >= 1e6 then return string.format("%.1fM", n / 1e6)
    elseif n >= 1e4 then return string.format("%.1fK", n / 1e3)
    end
        return tostring(math.floor(n))
    end
 
    local function fmtMult(m)
        local s = string.format("%.2f", m)
        s = s:gsub("0+$", "")
        s = s:gsub("%.$", "")
        return s
    end
 
    local function makeButton(parent, o)
        local btn = new("TextButton", {
        Name = o.Name or "Button",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = o.Size,
        Position = o.Position,
        BackgroundColor3 = WHITE,
        AutoButtonColor = false,
        Text = "",
        ZIndex = o.ZIndex or 1,
        }, parent)
        corner(btn, o.Radius or 14)
        border(btn, NAVY, 4)
        local grad = gradient(btn, o.Colors)
        local scale = new("UIScale", { Scale = 1 }, btn)
 
        local label = new("TextLabel", {
        Name = "Label",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Font = FONT,
        TextSize = o.TextSize or 24,
        TextColor3 = WHITE,
        RichText = true,
        Text = o.Text or "",
        ZIndex = (o.ZIndex or 1) + 1,
        }, btn)
        textStroke(label, NAVY, o.TextStrokeThickness or 3)
 
        btn.MouseButton1Down:Connect(function() tween(scale, 0.08, { Scale = 0.92 }) end)
            btn.MouseButton1Up:Connect(function() tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back) end)
                btn.MouseLeave:Connect(function() tween(scale, 0.12, { Scale = 1 }) end)
                    btn.MouseEnter:Connect(function() tween(scale, 0.12, { Scale = 1.05 }) end)
 
                        return btn, label, grad
                    end
 
                    local function pill(parent, size, position, anchor)
                        local f = new("Frame", {
                        Size = size, Position = position or UDim2.new(),
                        AnchorPoint = anchor or Vector2.zero,
                        BackgroundColor3 = WHITE,
                        }, parent)
                        corner(f, size.Y.Offset / 2)
                        border(f, NAVY, 4)
                        gradient(f, COLORS.DARK)
                        return f
                    end
 
                    local function pillText(parent, size, color)
                        local l = new("TextLabel", {
                        Size = UDim2.fromScale(1, 1),
                        BackgroundTransparency = 1,
                        Font = FONT, TextSize = size,
                        TextColor3 = color or WHITE,
                        RichText = true, Text = "",
                        }, parent)
                        textStroke(l, NAVY, 3)
                        return l
                    end
 
                    local gui = new("ScreenGui", {
                    Name = "GameUI", ResetOnSpawn = false, IgnoreGuiInset = true,
                    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
                    }, player:WaitForChild("PlayerGui"))
 
                    local root = new("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, gui)
                    local rootScale = new("UIScale", {}, root)
 
                    local function updateScale()
                        local s = math.clamp(camera.ViewportSize.Y / 760, 0.5, 1.4)
                        rootScale.Scale = s
                        root.Size = UDim2.fromScale(1 / s, 1 / s)
                    end
                    updateScale()
                    camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
 
                    local toast = pill(root, UDim2.fromOffset(340, 46), UDim2.new(0.5, 0, 0, 70), Vector2.new(0.5, 0))
                    toast.Visible = false
                    toast.ZIndex = 50
                    local toastLabel = pillText(toast, 22, GOLD)
                    toastLabel.RichText = false
                    toastLabel.TextScaled = true
                    new("UITextSizeConstraint", { MaxTextSize = 22 }, toastLabel)
                    new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, toastLabel)
 
                    local toastId = 0
                    local function showToast(text)
                        toastId += 1
                        local my = toastId
                        toastLabel.Text = text
                        toast.Position = UDim2.new(0.5, 0, 0, 50)
                        toast.Visible = true
                        tween(toast, 0.25, { Position = UDim2.new(0.5, 0, 0, 70) }, Enum.EasingStyle.Back)
                        task.delay(2.5, function()
                            if toastId == my then toast.Visible = false end
                        end)
                    end
 
                    ReplicatedStorage:WaitForChild("Notify").OnClientEvent:Connect(showToast)
 
                    return {
                    NAVY = NAVY, WHITE = WHITE, GOLD = GOLD, FONT = FONT,
                    TITLE_FONT = Enum.Font.LuckiestGuy,
                    COLORS = COLORS,
                    tween = tween, new = new, corner = corner, border = border,
                    textStroke = textStroke, gradient = gradient,
                    abbr = abbr, fmtMult = fmtMult,
                    makeButton = makeButton, pill = pill, pillText = pillText,
                    root = root, showToast = showToast,
                    }

]]></ProtectedString>
