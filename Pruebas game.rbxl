<string name="Name">Sounds</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
 
------------------------------------------------------------
-- PEGA AQUI TUS IDs (solo el numero, entre comillas)
-- Ejemplo: local XP_SOUND_ID = "1234567890"
------------------------------------------------------------
local XP_SOUND_ID = "101023147710668"        -- sonido al ganar XP
local UPGRADE_SOUND_ID = "133292918309565"   -- sonido al comprar una mejora
local XP_SOUND_VOLUME = 0.5
local UPGRADE_SOUND_VOLUME = 0.8
------------------------------------------------------------
 
local player = Players.LocalPlayer
local levelValue = player:WaitForChild("leaderstats"):WaitForChild("Level")
 
local function makeSound(id, volume)
    if id == "" then return nil end
    local s = Instance.new("Sound")
    s.SoundId = string.find(id, "rbxassetid") and id or ("rbxassetid://" .. id)
    s.Volume = volume
    s.Parent = SoundService
    return s
end
 
local xpSound = makeSound(XP_SOUND_ID, XP_SOUND_VOLUME)
local upgradeSound = makeSound(UPGRADE_SOUND_ID, UPGRADE_SOUND_VOLUME)
 
local lastXP = player:GetAttribute("XP") or 0
local lastLevel = levelValue.Value
local lastPlay = 0
 
local function playXP()
    if not xpSound then return end
    if os.clock() - lastPlay < 0.25 then return end
    lastPlay = os.clock()
    xpSound:Play()
end
 
-- Suena cuando ganas XP o subes de nivel
player:GetAttributeChangedSignal("XP"):Connect(function()
    local xp = player:GetAttribute("XP") or 0
    if xp > lastXP or levelValue.Value > lastLevel then
        playXP()
    end
    lastXP = xp
    lastLevel = levelValue.Value
end)
 
-- Suena cuando compras una mejora
player:GetAttributeChangedSignal("UpgradeBought"):Connect(function()
    if upgradeSound then
        upgradeSound:Play()
    end
end)

]]></ProtectedString>
