<Item class="Script" referent="RBX66C1625455D04AC580D8104907513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Shop</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local Core = require(script.Parent:WaitForChild("GameCore"))
local Config = require(ReplicatedStorage:WaitForChild("Config"))
 
local CONFIG = Core.CONFIG
local data = Core.data
 
local shopRF = Instance.new("RemoteFunction")
shopRF.Name = "ShopRequest"
shopRF.Parent = ReplicatedStorage
 
-- Speed (XP) que ganarias farmeando X segundos en tu mejor caminadora
local function speedFor(player, seconds)
    local perSecond = Core.xpPerTick(player) / CONFIG.TickInterval
    return math.floor(perSecond * Config.BestTreadmillMult * seconds)
end
 
------------------------------------------------------------
-- TRAILS (estela)
------------------------------------------------------------
local function applyTrail(player)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local d = data[player]
    if not hrp or not d then return end
 
    for _, n in ipairs({ "GameTrail", "TrailA", "TrailB" }) do
        local old = hrp:FindFirstChild(n)
        if old then old:Destroy() end
    end
 
    local cfg = Config.getTrail(d.Equipped)
    if not cfg then return end
 
    local a0 = Instance.new("Attachment")
    a0.Name = "TrailA"
    a0.Position = Vector3.new(0, (cfg.Width or 1.6) / 2, 0)
    a0.Parent = hrp
    local a1 = Instance.new("Attachment")
    a1.Name = "TrailB"
    a1.Position = Vector3.new(0, -(cfg.Width or 1.6) / 2, 0)
    a1.Parent = hrp
 
    local tr = Instance.new("Trail")
    tr.Name = "GameTrail"
    tr.Attachment0 = a0
    tr.Attachment1 = a1
    tr.Color = ColorSequence.new(cfg.Color1, cfg.Color2)
    tr.Lifetime = cfg.Lifetime or 0.8
    tr.LightEmission = 0.6
    tr.Transparency = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 0.1),
    NumberSequenceKeypoint.new(1, 1),
    })
    local tex = Config.assetId(cfg.Texture)
    if tex then
        tr.Texture = tex
        tr.TextureMode = Enum.TextureMode.Stretch
    end
    tr.Parent = hrp
end
 
------------------------------------------------------------
-- PASES
------------------------------------------------------------
local function checkPasses(player)
    for key, p in pairs(Config.Passes) do
        if p.Id ~= 0 then
            local ok, owns = pcall(function()
                return MarketplaceService:UserOwnsGamePassAsync(player.UserId, p.Id)
            end)
            if ok and owns and Core.passes[player] then
                Core.passes[player][key] = true
            end
        end
    end
    Core.refresh(player)
end
 
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
    if not purchased or not Core.passes[player] then return end
    for key, p in pairs(Config.Passes) do
        if p.Id ~= 0 and p.Id == passId then
            Core.passes[player][key] = true
            Core.refresh(player)
            Core.notify(player, "¡Pase " .. p.Mult .. "x " .. key .. " activado! 👑")
        end
    end
end)
 
Players.PlayerAdded:Connect(function(player)
    local t = 0
    while not data[player] and player.Parent and t < 20 do
        task.wait(0.5)
        t += 0.5
    end
    if not data[player] then return end
    checkPasses(player)
 
    local function onChar(char)
        char:WaitForChild("HumanoidRootPart")
        task.wait(0.2)
        applyTrail(player)
    end
    player.CharacterAdded:Connect(onChar)
    if player.Character then
        task.spawn(onChar, player.Character)
    end
end)
 
Players.PlayerRemoving:Connect(function(player)
    Core.passes[player] = nil
end)
 
------------------------------------------------------------
-- COMPRAS CON ROBUX (productos de los botones de abajo)
------------------------------------------------------------
MarketplaceService.ProcessReceipt = function(receipt)
    local player = Players:GetPlayerByUserId(receipt.PlayerId)
    local d = player and data[player]
    if not d then
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end
 
    if CONFIG.SkipRebirthProductId ~= 0 and receipt.ProductId == CONFIG.SkipRebirthProductId then
        Core.doRebirth(player)
        Core.save(player)
        return Enum.ProductPurchaseDecision.PurchaseGranted
    end
 
    for _, p in ipairs(Config.Products) do
        if p.Id ~= 0 and p.Id == receipt.ProductId then
            if p.Kind == "Wins" then
                d.Wins += p.Amount
                Core.refresh(player)
                Core.notify(player, "+" .. p.Amount .. " Wins 🏆")
            else
                local amount = speedFor(player, p.Seconds)
                Core.addXP(player, amount)
                Core.notify(player, "+" .. amount .. " Speed ⚡")
            end
            Core.save(player)
            return Enum.ProductPurchaseDecision.PurchaseGranted
        end
    end
    return Enum.ProductPurchaseDecision.NotProcessedYet
end
 
------------------------------------------------------------
-- ACCIONES DEL CLIENTE
------------------------------------------------------------
local lastCall = {}
 
local function dailyDay(d, now)
    if d.DailyLast > 0 and now - d.DailyLast > 172800 then
        return 1
    end
    return (d.DailyStreak % #Config.Daily) + 1
end
 
shopRF.OnServerInvoke = function(player, action, arg)
    local d = data[player]
    if not d then return { ok = false } end
 
    local t = os.clock()
    if lastCall[player] and t - lastCall[player] < 0.15 then
        return { ok = false }
    end
    lastCall[player] = t
 
    if action == "trail_buy" then
        local cfg = Config.getTrail(tostring(arg))
        if not cfg then return { ok = false } end
        if d.Trails[cfg.Id] then
            Core.notify(player, "Ya tienes este trail")
            return { ok = false }
        end
        if d.Wins < cfg.Cost then
            Core.notify(player, "Te faltan " .. (cfg.Cost - d.Wins) .. " wins")
            return { ok = false }
        end
        d.Wins -= cfg.Cost
        d.Trails[cfg.Id] = true
        d.Equipped = cfg.Id
        Core.refresh(player)
        applyTrail(player)
        Core.notify(player, "Compraste " .. cfg.Name .. " ✨")
        player:SetAttribute("UpgradeBought", (player:GetAttribute("UpgradeBought") or 0) + 1)
        return { ok = true }
 
    elseif action == "trail_equip" then
        local id = tostring(arg or "")
        if id ~= "" and not d.Trails[id] then return { ok = false } end
        d.Equipped = id
        Core.refresh(player)
        applyTrail(player)
        return { ok = true }
 
    elseif action == "daily" then
        local now = os.time()
        if d.DailyLast > 0 and now - d.DailyLast < 86400 then
            Core.notify(player, "Todavía no está listo")
            return { ok = false }
        end
        local day = dailyDay(d, now)
        local reward = Config.Daily[day]
        d.DailyStreak = (now - d.DailyLast > 172800 and d.DailyLast > 0) and 1 or d.DailyStreak + 1
        d.DailyLast = now
        d.Wins += reward
        Core.refresh(player)
        Core.notify(player, "Daily día " .. day .. ": +" .. reward .. " Wins 🎁")
        return { ok = true }
 
    elseif action == "free" then
        local now = os.time()
        if now - d.FreeLast < Config.Free.Cooldown then
            Core.notify(player, "Todavía no está listo")
            return { ok = false }
        end
        d.FreeLast = now
        d.Wins += Config.Free.Wins
        local sp = speedFor(player, Config.Free.SpeedSeconds)
        Core.addXP(player, sp)
        Core.notify(player, "¡Regalo! +" .. Config.Free.Wins .. " Wins y +" .. sp .. " Speed 🎁")
        return { ok = true }
 
    elseif action == "speedpct" then
        local n = tonumber(arg)
        if not n then return { ok = false } end
        d.SpeedPct = math.clamp(math.floor(n), 5, 100)
        Core.refresh(player)
        return { ok = true }
 
    elseif action == "buy_product" then
        local p = Config.Products[tonumber(arg) or 0]
        if not p then return { ok = false } end
        if p.Id == 0 then
            Core.notify(player, "Próximamente")
            return { ok = false }
        end
        MarketplaceService:PromptProductPurchase(player, p.Id)
        return { ok = true }
 
    elseif action == "buy_pass" then
        local key = tostring(arg)
        local p = Config.Passes[key]
        if not p then return { ok = false } end
        if Core.passes[player] and Core.passes[player][key] then
            Core.notify(player, "Ya tienes este pase 👑")
            return { ok = false }
        end
        if p.Id == 0 then
            Core.notify(player, "Próximamente")
            return { ok = false }
        end
        MarketplaceService:PromptGamePassPurchase(player, p.Id)
        return { ok = true }
    end
 
    return { ok = false }
end

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8049080041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8104909513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">WinsAndUpgrades</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Core = require(script.Parent:WaitForChild("GameCore"))
 
local CONFIG = Core.CONFIG
local data = Core.data
 
------------------------------------------------------------
-- PARTES DE WINS (opcional: NumberValue "Wins" dentro de la parte)
------------------------------------------------------------
local winCooldown = {}
 
local function connectWinPart(part)
    part.Touched:Connect(function(hit)
        local char = hit:FindFirstAncestorOfClass("Model")
        local player = char and Players:GetPlayerFromCharacter(char)
        if not player or not data[player] or winCooldown[player] then return end
        winCooldown[player] = true
        
        local amount = Core.getNum(part, "Wins", CONFIG.DefaultWinsPerPart) * Core.winsMultiplier(player)
        data[player].Wins += amount
        Core.refresh(player)
        Core.notify(player, "+" .. amount .. " Wins 🏆")
        
        local ok, err = pcall(Core.teleportToStart, player)
        if not ok then
            warn("No se pudo llevar al Start: " .. tostring(err))
        end
        
        task.delay(1, function()
            winCooldown[player] = nil
        end)
    end)
end
 
for _, part in ipairs(Core.winParts:GetDescendants()) do
    if part:IsA("BasePart") then
        connectWinPart(part)
    end
end
 
Players.PlayerRemoving:Connect(function(player)
    winCooldown[player] = nil
end)
 
------------------------------------------------------------
-- MEJORAS: se compran SOLO PISANDOLAS
-- Cada parte necesita 2 NumberValue: "XP" (el bono de speed) y "Cost" (wins)
------------------------------------------------------------
local busy = {}
 
local function buildUpgrade(part)
    local xp = Core.getNum(part, "XP", nil)
    local cost = Core.getNum(part, "Cost", nil)
    if not xp or not cost then
        warn("La parte '" .. part.Name .. "' en Upgrades necesita NumberValue XP y Cost")
        xp = xp or 0
        cost = cost or 0
    end
    
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromScale(7, 3.2)
    bb.StudsOffset = Vector3.new(0, part.Size.Y / 2 + 2.6, 0)
    bb.MaxDistance = CONFIG.UpgradeShowDistance
    bb.LightInfluence = 0
    bb.Adornee = part
    bb.Parent = part
    
    local card = Instance.new("Frame")
    card.Size = UDim2.fromScale(1, 1)
    card.BackgroundColor3 = Color3.new(1, 1, 1)
    card.Parent = bb
    Instance.new("UICorner", card).CornerRadius = UDim.new(0.25, 0)
    
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new(Color3.fromRGB(90, 100, 170), Color3.fromRGB(40, 45, 100))
    grad.Rotation = 90
    grad.Parent = card
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(18, 32, 92)
    stroke.Thickness = 3
    stroke.Parent = card
    
    local function makeText(y, h, color, text)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.fromScale(1, h)
        l.Position = UDim2.fromScale(0, y)
        l.BackgroundTransparency = 1
        l.Font = Enum.Font.FredokaOne
        l.TextScaled = true
        l.TextColor3 = color
        l.Text = text
        l.Parent = card
        local s = Instance.new("UIStroke")
        s.Color = Color3.fromRGB(18, 32, 92)
        s.Thickness = 2
        s.Parent = l
    end
    makeText(0.04, 0.58, Color3.fromRGB(110, 255, 120), "+" .. xp .. " Speed")
    makeText(0.62, 0.34, Color3.fromRGB(255, 226, 90), "🏆 " .. cost)
    
    part.Touched:Connect(function(hit)
        local char = hit:FindFirstAncestorOfClass("Model")
        local player = char and Players:GetPlayerFromCharacter(char)
        local d = player and data[player]
        if not d then return end
        if d.Upgrades[part.Name] then return end
        
        local key = player.UserId .. "_" .. part.Name
        if busy[key] then return end
        busy[key] = true
        
        if d.Wins < cost then
            Core.notify(player, "Te faltan " .. (cost - d.Wins) .. " wins")
            task.delay(2, function()
                busy[key] = nil
            end)
            return
        end
        
        d.Wins -= cost
        d.Upgrades[part.Name] = true
        Core.refresh(player)
        Core.notify(player, "Compraste +" .. xp .. " Speed ✅")
        player:SetAttribute("UpgradeBought", (player:GetAttribute("UpgradeBought") or 0) + 1)
        busy[key] = nil
    end)
end
 
for _, part in ipairs(Core.upgradesFolder:GetDescendants()) do
    if part:IsA("BasePart") then
        buildUpgrade(part)
    end
end

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8049100041fa</UniqueId>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX6A5AB5395EC24443840DD04911C34F7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">GameCore</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
 
local Core = {}
 
------------------------------------------------------------
-- CONFIG (cambia lo que quieras)
------------------------------------------------------------
Core.CONFIG = {
BaseWalkSpeed = 16,
SpeedPerLevel = 1,          -- +1 velocidad real por nivel
TickInterval = 0.5,         -- cada cuanto da speed la caminadora
BaseXPPerTick = 1,          -- speed base por tick
XPBase = 20,                -- speed para el nivel 1
XPGrowth = 3,               -- cuanto mas pide cada nivel (XPBase + nivel^2 * XPGrowth)
RebirthBaseLevel = 50,      -- primer renacimiento en nivel 50
RebirthLevelStep = 15,      -- luego 65, 80, 95...
RebirthXPBonus = 0.5,       -- +0.5x por renacimiento
DefaultWinsPerPart = 1,
SkipRebirthProductId = 0,
UpgradeShowDistance = 45,
}
local CONFIG = Core.CONFIG
 
------------------------------------------------------------
-- WORKSPACE
------------------------------------------------------------
Core.treadmills = workspace:WaitForChild("Treadmills")
Core.winParts = workspace:WaitForChild("WinParts")
Core.upgradesFolder = workspace:WaitForChild("Upgrades")
Core.startObj = workspace:WaitForChild("Start")
 
------------------------------------------------------------
-- REMOTES
------------------------------------------------------------
local function makeRemote(name)
    local r = Instance.new("RemoteEvent")
    r.Name = name
    r.Parent = ReplicatedStorage
    return r
end
 
Core.rebirthRemote = makeRemote("Rebirth")
Core.skipRemote = makeRemote("SkipRebirth")
Core.notifyRemote = makeRemote("Notify")
 
------------------------------------------------------------
-- DATOS
------------------------------------------------------------
Core.store = DataStoreService:GetDataStore("KeyboardEscapeV3")
Core.data = {}
Core.passes = {} -- [Player] = { Speed = bool, Wins = bool }
 
function Core.getNum(part, name, default)
    local child = part:FindFirstChild(name)
    if child and child:IsA("ValueBase") then
        return child.Value
    end
    local attr = part:GetAttribute(name)
    if attr ~= nil then
        return attr
    end
    return default
end
 
function Core.xpNeeded(level)
    return math.floor(CONFIG.XPBase + level * level * CONFIG.XPGrowth)
end
 
function Core.rebirthLevelNeeded(rebirths)
    return CONFIG.RebirthBaseLevel + CONFIG.RebirthLevelStep * rebirths
end
 
function Core.getMultiplier(rebirths)
    return 1 + rebirths * CONFIG.RebirthXPBonus
end
 
function Core.passSpeedMult(player)
    local p = Core.passes[player]
    return (p and p.Speed) and Config.Passes.Speed.Mult or 1
end
 
function Core.winsMultiplier(player)
    local p = Core.passes[player]
    return (p and p.Wins) and Config.Passes.Wins.Mult or 1
end
 
function Core.trailMult(player)
    local d = Core.data[player]
    local t = d and Config.getTrail(d.Equipped)
    return t and t.Mult or 1
end
 
function Core.notify(player, text)
    Core.notifyRemote:FireClient(player, text)
end
 
function Core.xpPerTick(player)
    local d = Core.data[player]
    local bonus = 0
    for _, part in ipairs(Core.upgradesFolder:GetDescendants()) do
        if part:IsA("BasePart") and d.Upgrades[part.Name] then
            bonus += Core.getNum(part, "XP", 0)
        end
    end
    return (CONFIG.BaseXPPerTick + bonus) * Core.getMultiplier(d.Rebirths)
    * Core.passSpeedMult(player) * Core.trailMult(player)
end
 
function Core.refresh(player)
    local d = Core.data[player]
    if not d then return end
    
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        ls.Level.Value = d.Level
        ls.Wins.Value = d.Wins
        ls.Rebirths.Value = d.Rebirths
    end
    
    local speed = CONFIG.BaseWalkSpeed + d.Level * CONFIG.SpeedPerLevel
    local owned = {}
    for id in pairs(d.Trails) do
        table.insert(owned, id)
    end
    
    player:SetAttribute("XP", d.XP)
    player:SetAttribute("XPNeeded", Core.xpNeeded(d.Level))
    player:SetAttribute("XPPerSecond", Core.xpPerTick(player) / CONFIG.TickInterval)
    player:SetAttribute("RebirthNeeded", Core.rebirthLevelNeeded(d.Rebirths))
    player:SetAttribute("XPMultiplier", Core.getMultiplier(d.Rebirths))
    player:SetAttribute("NextXPMultiplier", Core.getMultiplier(d.Rebirths + 1))
    player:SetAttribute("Speed", speed)
    player:SetAttribute("Total", d.Total)
    player:SetAttribute("PassSpeed", Core.passSpeedMult(player))
    player:SetAttribute("PassWins", Core.winsMultiplier(player))
    player:SetAttribute("TrailMult", Core.trailMult(player))
    player:SetAttribute("EquippedTrail", d.Equipped)
    player:SetAttribute("OwnedTrails", table.concat(owned, ","))
    player:SetAttribute("SpeedPct", d.SpeedPct)
    player:SetAttribute("DailyLast", d.DailyLast)
    player:SetAttribute("DailyStreak", d.DailyStreak)
    player:SetAttribute("FreeLast", d.FreeLast)
    
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = math.max(1, math.floor(speed * d.SpeedPct / 100))
    end
end
 
function Core.teleportToStart(player)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local startObj = Core.startObj
    local cf
    if startObj:IsA("BasePart") then
        cf = startObj.CFrame + Vector3.new(0, startObj.Size.Y / 2 + 3, 0)
    else
        cf = startObj:GetPivot() + Vector3.new(0, 5, 0)
    end
    
    hrp.AssemblyLinearVelocity = Vector3.zero
    char:PivotTo(cf)
end
 
function Core.addXP(player, amount)
    local d = Core.data[player]
    if not d then return end
    d.XP += amount
    d.Total += amount
    while d.XP >= Core.xpNeeded(d.Level) do
        d.XP -= Core.xpNeeded(d.Level)
        d.Level += 1
    end
    Core.refresh(player)
end
 
function Core.doRebirth(player)
    local d = Core.data[player]
    if not d then return end
    d.Rebirths += 1
    d.Level = 0
    d.XP = 0
    d.Total = 0
    Core.refresh(player)
    pcall(Core.teleportToStart, player)
    Core.notify(player, "¡Renaciste! Multiplier x" .. Core.getMultiplier(d.Rebirths) .. " 🔥")
end
 
function Core.load(player)
    local saved
    pcall(function()
        saved = Core.store:GetAsync("P_" .. player.UserId)
    end)
    saved = saved or {}
    
    local d = {
    XP = saved.XP or 0,
    Level = saved.Level or 0,
    Wins = saved.Wins or 0,
    Rebirths = saved.Rebirths or 0,
    Upgrades = saved.Upgrades or {},
    Total = saved.Total or 0,
    Trails = saved.Trails or {},
    Equipped = saved.Equipped or "",
    DailyLast = saved.DailyLast or 0,
    DailyStreak = saved.DailyStreak or 0,
    FreeLast = saved.FreeLast or 0,
    SpeedPct = saved.SpeedPct or 100,
    }
    Core.data[player] = d
    Core.passes[player] = {}
    return d
end
 
function Core.save(player)
    local d = Core.data[player]
    if not d then return end
    local ok, err = pcall(function()
        Core.store:SetAsync("P_" .. player.UserId, d)
    end)
    if not ok then
        warn("No se pudo guardar a " .. player.Name .. ": " .. tostring(err))
    end
end
 
return Core

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d0689404912004383</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8104913513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">MessageServer</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MessagingService = game:GetService("MessagingService")
local TextService = game:GetService("TextService")
 
local TOPIC = "KE_GlobalMessage2"
local MAX_MSG_LEN = 120
 
-- Estilos de letra permitidos
local FONTS = {
FredokaOne = true, LuckiestGuy = true, Bangers = true, Cartoon = true,
Arcade = true, PermanentMarker = true, Creepster = true, GothamBold = true,
}
 
local messageRE = ReplicatedStorage:WaitForChild("GlobalMessage")
 
local messageRF = Instance.new("RemoteFunction")
messageRF.Name = "AdminMessage"
messageRF.Parent = ReplicatedStorage
 
local function trim(s)
    return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end
 
local function readColor(c, default)
    if type(c) ~= "table" then return default end
    local r, g, b = tonumber(c[1]), tonumber(c[2]), tonumber(c[3])
    if not (r and g and b) or r ~= r or g ~= g or b ~= b then return default end
    return {
    math.floor(math.clamp(r, 0, 255)),
    math.floor(math.clamp(g, 0, 255)),
    math.floor(math.clamp(b, 0, 255)),
    }
end
 
local function filterText(text, fromPlayer)
    local ok, result = pcall(function()
        local obj = TextService:FilterStringAsync(text, fromPlayer.UserId)
        return obj:GetNonChatStringForBroadcastAsync()
    end)
    if ok then return result end
    return nil
end
 
local lastSend = {}
 
messageRF.OnServerInvoke = function(player, p)
    if type(p) ~= "table" then return { ok = false } end
    
    -- Solo admins (AdminServer les pone este atributo)
    if player:GetAttribute("IsAdmin") ~= true then
        return { ok = false, msg = "No tienes permiso" }
    end
    
    local text = trim(p.text)
    local len = utf8.len(text)
    if not len or len < 1 then return { ok = false, msg = "Escribe un mensaje" } end
    if len > MAX_MSG_LEN then return { ok = false, msg = "Máximo " .. MAX_MSG_LEN .. " caracteres" } end
    
    local now = os.clock()
    if lastSend[player] and now - lastSend[player] < 2 then
        return { ok = false, msg = "Espera un momento" }
    end
    
    local clean = filterText(text, player)
    if not clean then return { ok = false, msg = "No se pudo enviar el mensaje" } end
    lastSend[player] = now
    
    local payload = {
    text = clean,
    name = player.DisplayName,
    userId = player.UserId,
    bg = readColor(p.bg, { 110, 70, 220 }),
    textColor = readColor(p.textColor, { 255, 255, 255 }),
    font = FONTS[p.font] and p.font or "FredokaOne",
    }
    
    if p.scope == "global" then
        local ok = pcall(function()
            MessagingService:PublishAsync(TOPIC, payload)
        end)
        if ok then
            return { ok = true, msg = "Mensaje global enviado 🌍" }
        end
        messageRE:FireAllClients(payload)
        return { ok = true, msg = "Global no disponible aquí, se envió a este server" }
    end
    
    messageRE:FireAllClients(payload)
    return { ok = true, msg = "Mensaje enviado a este server ✅" }
end
 
-- Recibe los mensajes globales de otros servers
task.spawn(function()
    pcall(function()
        MessagingService:SubscribeAsync(TOPIC, function(message)
            local d = message.Data
            if type(d) == "table" and type(d.text) == "string" then
                messageRE:FireAllClients(d)
            end
        end)
    end)
end)
 
Players.PlayerRemoving:Connect(function(player)
    lastSend[player] = nil
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8049140041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8104915513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Main</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Core = require(script.Parent:WaitForChild("GameCore"))

local CONFIG = Core.CONFIG
local data = Core.data

-- Cuanta XP da caminar fuera de la caminadora (0.25 = 25%)
local WALK_XP_FACTOR = 0.25

-- Da XP y avisa al cliente para mostrar los numeros flotando
local function giveXP(player, amount)
    Core.addXP(player, amount)
    player:SetAttribute("XPGain", amount)
    player:SetAttribute("XPGainId", (player:GetAttribute("XPGainId") or 0) + 1)
end

local function getTreadmill(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char }
    local result = workspace:Raycast(hrp.Position, Vector3.new(0, -8, 0), params)
    if result and result.Instance:IsDescendantOf(Core.treadmills) then
        return result.Instance
    end
    return nil
end

local function getTreadmillMultiplier(part)
    local m = Core.getNum(part, "Multiplier", nil)
    if m == nil and part.Parent and part.Parent ~= Core.treadmills then
        m = Core.getNum(part.Parent, "Multiplier", nil)
    end
    return m or 1
end

local function startXPLoop(player)
    task.spawn(function()
        while player.Parent do
            task.wait(CONFIG.TickInterval)
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if data[player] and hum and hum.Health > 0 then
                local treadmill = getTreadmill(char)
                if treadmill then
                    giveXP(player, Core.xpPerTick(player) * getTreadmillMultiplier(treadmill))
                elseif hum.MoveDirection.Magnitude > 0 and hum.FloorMaterial ~= Enum.Material.Air then
                    giveXP(player, Core.xpPerTick(player) * WALK_XP_FACTOR)
                end
            end
        end
    end)
end

Players.PlayerAdded:Connect(function(player)
    Core.load(player)
    
    local folder = Instance.new("Folder")
    folder.Name = "leaderstats"
    folder.Parent = player
    for _, name in ipairs({ "Level", "Wins", "Rebirths" }) do
        local v = Instance.new("IntValue")
        v.Name = name
        v.Parent = folder
    end
    
    Core.refresh(player)
    
    player.CharacterAdded:Connect(function(char)
        char:WaitForChild("Humanoid")
        Core.refresh(player)
    end)
    if player.Character then
        Core.refresh(player)
    end
    
    startXPLoop(player)
end)

Players.PlayerRemoving:Connect(function(player)
    Core.save(player)
    data[player] = nil
end)

task.spawn(function()
    while true do
        task.wait(60)
        for player in pairs(data) do
            Core.save(player)
        end
    end
end)

game:BindToClose(function()
    for player in pairs(data) do
        Core.save(player)
    end
end)

]]></ProtectedString>
