<string name="Name">StarterPlayerScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
 
local deco = {}
 
local function reg(p)
    if p:IsA("BasePart") then
        deco[p] = {cf = p.CFrame, amp = p:GetAttribute("Amp") or 0, velF = p:GetAttribute("VelF") or 1.5,
        fase = p:GetAttribute("Fase") or 0, giro = p:GetAttribute("Giro") or 0}
    end
end
 
for _, p in ipairs(CollectionService:GetTagged("AnimaDeco")) do reg(p) end
CollectionService:GetInstanceAddedSignal("AnimaDeco"):Connect(reg)
CollectionService:GetInstanceRemovedSignal("AnimaDeco"):Connect(function(p) deco[p] = nil end)
    
    RunService.RenderStepped:Connect(function()
        local t = os.clock()
        for p, d in pairs(deco) do
            local cf = d.cf
            if d.giro ~= 0 then cf = cf * CFrame.Angles(0, t * d.giro, 0) end
            if d.amp ~= 0 then cf = cf + Vector3.new(0, math.sin(t * d.velF + d.fase) * d.amp, 0) end
            p.CFrame = cf
        end
    end)

]]></ProtectedString>
