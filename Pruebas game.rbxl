<Item class="Script" referent="RBX66C1625455D04AC580D8104901513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Anclar</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- ANCLAR CAMINADORAS: no genera nada, solo evita que se caigan
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
 
local PREFIJO = "Caminadora"  -- cualquier Model o Folder cuyo nombre empiece asi
 
local procesadas = {}
 
local function anclar(o)
    if o:IsA("BasePart") then
        o.Anchored = true
        o.AssemblyLinearVelocity = Vector3.zero
        o.AssemblyAngularVelocity = Vector3.zero
    end
end
 
local function coincide(o)
    return (o:IsA("Model") or o:IsA("Folder")) and string.sub(o.Name, 1, #PREFIJO) == PREFIJO
end
 
local function procesar(raiz)
    if procesadas[raiz] then return end
    procesadas[raiz] = true
    for _, d in ipairs(raiz:GetDescendants()) do anclar(d) end
    raiz.DescendantAdded:Connect(anclar)
    raiz.Destroying:Connect(function() procesadas[raiz] = nil end)
    end
 
        -- lo que ya existe en el Workspace
        for _, o in ipairs(Workspace:GetDescendants()) do
            if coincide(o) then procesar(o) end
        end
 
        -- lo que pegues despues
        Workspace.DescendantAdded:Connect(function(o)
            if coincide(o) then procesar(o) end
        end)
 
        -- en la barra de comandos: tambien ancla lo que tengas seleccionado
        pcall(function()
            for _, o in ipairs(game:GetService("Selection"):Get()) do
                anclar(o)
                for _, d in ipairs(o:GetDescendants()) do anclar(d) end
            end
        end)
 
        -- en Play: revisa cada 3 segundos por si algo lo desancla
        if RunService:IsRunning() then
            task.spawn(function()
                while true do
                    task.wait(3)
                    for raiz in pairs(procesadas) do
                        for _, d in ipairs(raiz:GetDescendants()) do
                            if d:IsA("BasePart") and not d.Anchored then anclar(d) end
                        end
                    end
                end
            end)
        end

]]></ProtectedString>
