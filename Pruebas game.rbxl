<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Bubble = require(script.Parent:WaitForChild("MessageBubble"))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local msgRemote = ReplicatedStorage:WaitForChild("GlobalMessage")

local gui = Instance.new("ScreenGui")
gui.Name = "GlobalMessageUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 20
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local root = Instance.new("Frame")
root.BackgroundTransparency = 1
root.Size = UDim2.fromScale(1, 1)
root.Parent = gui

local rootScale = Instance.new("UIScale")
rootScale.Parent = root

local function updateScale()
    local s = math.clamp(camera.ViewportSize.Y / 760, 0.55, 1.3)
    rootScale.Scale = s
    root.Size = UDim2.fromScale(1 / s, 1 / s)
end
updateScale()
camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)

local bubble = Bubble.new(root, 540)
local group = bubble.group
group.AnchorPoint = Vector2.new(0.5, 0)
group.Position = UDim2.new(0.5, 0, 0, -30)
group.GroupTransparency = 1
group.Visible = false

local queue = {}
local busy = false

local function tween(obj, t, props, style)
    local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function processQueue()
    if busy then return end
    busy = true
    while #queue > 0 do
        local data = table.remove(queue, 1)
        bubble.set(data)
        
        group.Position = UDim2.new(0.5, 0, 0, -30)
        group.GroupTransparency = 1
        group.Visible = true
        tween(group, 0.4, { Position = UDim2.new(0.5, 0, 0, 16), GroupTransparency = 0 }, Enum.EasingStyle.Back)
        
        task.wait(math.clamp(3.5 + #data.text * 0.05, 4, 9))
        
        -- Se desvanece
        tween(group, 0.8, { Position = UDim2.new(0.5, 0, 0, 0), GroupTransparency = 1 })
        task.wait(0.9)
        group.Visible = false
    end
    busy = false
end

msgRemote.OnClientEvent:Connect(function(data)
    if type(data) == "string" then
        data = { text = data }
    end
    if type(data) ~= "table" or type(data.text) ~= "string" then return end
    table.insert(queue, data)
    processQueue()
end)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940486800437f</UniqueId>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454104869AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">AdminMessages</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
 
local Admin = require(script.Parent:WaitForChild("AdminCore"))
local UI = require(script.Parent:WaitForChild("UI"))
local Bubble = require(script.Parent:WaitForChild("MessageBubble"))
 
local player = Players.LocalPlayer
local messageRF = ReplicatedStorage:WaitForChild("AdminMessage")
 
local new, corner, border = UI.new, UI.corner, UI.border
local makeButton = UI.makeButton
local WHITE, GOLD = UI.WHITE, UI.GOLD
local C = Admin.COLORS
local LINE = Admin.LINE
local GRAYTEXT = Color3.fromRGB(190, 198, 220)
local MAX_LEN = 120
 
local bgColors = {
Color3.fromRGB(110, 70, 220), Color3.fromRGB(50, 120, 240), Color3.fromRGB(30, 170, 200),
Color3.fromRGB(40, 170, 90), Color3.fromRGB(240, 190, 40), Color3.fromRGB(240, 120, 30),
Color3.fromRGB(220, 60, 70), Color3.fromRGB(240, 90, 170), Color3.fromRGB(30, 30, 40),
Color3.fromRGB(245, 245, 250),
}
local textColors = {
Color3.fromRGB(255, 255, 255), Color3.fromRGB(20, 20, 25), Color3.fromRGB(255, 226, 90),
Color3.fromRGB(110, 230, 255), Color3.fromRGB(120, 255, 130), Color3.fromRGB(255, 170, 60),
Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 140, 210), Color3.fromRGB(200, 150, 255),
Color3.fromRGB(120, 170, 255),
}
local fontNames = {
"FredokaOne", "LuckiestGuy", "Bangers", "Cartoon",
"Arcade", "PermanentMarker", "Creepster", "GothamBold",
}
 
local selBg = bgColors[1]
local selText = textColors[1]
local selFont = fontNames[1]
local scope = "server"
 
local function rgb(c)
    return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
end
 
------------------------------------------------------------
-- Pagina con scroll
------------------------------------------------------------
local page = Admin.pages.Mensajes
local scroll = new("ScrollingFrame", {
Size = UDim2.fromScale(1, 1),
BackgroundTransparency = 1,
BorderSizePixel = 0,
ScrollBarThickness = 6,
CanvasSize = UDim2.fromOffset(0, 520),
ScrollingDirection = Enum.ScrollingDirection.Y,
}, page)
 
local msgBox = Admin.makeBox(scroll, "Escribe el mensaje... (máx 120 letras)",
UDim2.fromOffset(536, 80), UDim2.fromOffset(12, 8), true)
 
local counter = Admin.makeLabel(scroll, "0/" .. MAX_LEN, UDim2.fromOffset(100, 16),
UDim2.fromOffset(448, 90), 14, GRAYTEXT, Enum.TextXAlignment.Right)
 
-- Vista previa (se define antes para poder actualizarla)
local updatePreview
local previewBubble = Bubble.new(scroll, 536)
previewBubble.group.Position = UDim2.fromOffset(12, 252)
 
updatePreview = function()
    local text = msgBox.Text ~= "" and msgBox.Text or "Así se verá tu mensaje 👀"
    previewBubble.set({
    text = text,
    name = player.DisplayName,
    userId = player.UserId,
    bg = rgb(selBg),
    textColor = rgb(selText),
    font = selFont,
    })
end
 
msgBox:GetPropertyChangedSignal("Text"):Connect(function()
    local len = utf8.len(msgBox.Text)
    if len and len > MAX_LEN then
        msgBox.Text = string.sub(msgBox.Text, 1, utf8.offset(msgBox.Text, MAX_LEN + 1) - 1)
        return
    end
    counter.Text = (len or 0) .. "/" .. MAX_LEN
    updatePreview()
end)
 
------------------------------------------------------------
-- Colores
------------------------------------------------------------
local function makeSwatches(y, colors, getSel, setSel)
    local items = {}
    local function refresh()
        for i, it in ipairs(items) do
            local sel = colors[i] == getSel()
            it.stroke.Color = sel and WHITE or LINE
            it.stroke.Thickness = sel and 4 or 3
            it.scale.Scale = sel and 1.18 or 1
        end
    end
    for i, color in ipairs(colors) do
        local sw = new("TextButton", {
        Position = UDim2.fromOffset(100 + 33 * (i - 1), y),
        Size = UDim2.fromOffset(28, 28),
        BackgroundColor3 = color,
        Text = "",
        AutoButtonColor = false,
        }, scroll)
        corner(sw, 14)
        items[i] = { stroke = border(sw, LINE, 3), scale = new("UIScale", { Scale = 1 }, sw) }
        sw.MouseButton1Click:Connect(function()
            setSel(color)
            refresh()
            updatePreview()
        end)
    end
    refresh()
end
 
Admin.makeLabel(scroll, "🎨 Fondo", UDim2.fromOffset(86, 28), UDim2.fromOffset(12, 112), 17, GOLD)
makeSwatches(112, bgColors, function() return selBg end, function(c) selBg = c end)
 
    Admin.makeLabel(scroll, "✏️ Texto", UDim2.fromOffset(86, 28), UDim2.fromOffset(12, 150), 17, GOLD)
    makeSwatches(150, textColors, function() return selText end, function(c) selText = c end)
 
        ------------------------------------------------------------
        -- Estilo de letra
        ------------------------------------------------------------
        Admin.makeLabel(scroll, "🔤 Letra", UDim2.fromOffset(86, 34), UDim2.fromOffset(12, 186), 17, GOLD)
 
        local fontButtons = {}
        local function refreshFonts()
            for _, f in ipairs(fontButtons) do
                local sel = f.name == selFont
                f.stroke.Color = sel and WHITE or LINE
                f.stroke.Thickness = sel and 4 or 3
                f.btn.BackgroundColor3 = sel and Color3.fromRGB(70, 78, 100) or Color3.fromRGB(46, 50, 63)
            end
        end
 
        for i, name in ipairs(fontNames) do
            local btn = new("TextButton", {
            Position = UDim2.fromOffset(100 + 56 * (i - 1), 186),
            Size = UDim2.fromOffset(52, 34),
            BackgroundColor3 = Color3.fromRGB(46, 50, 63),
            Font = Enum.Font[name],
            TextSize = 22,
            TextColor3 = WHITE,
            Text = "Aa",
            AutoButtonColor = false,
            }, scroll)
            corner(btn, 10)
            fontButtons[i] = { name = name, btn = btn, stroke = border(btn, LINE, 3) }
            btn.MouseButton1Click:Connect(function()
                selFont = name
                refreshFonts()
                updatePreview()
            end)
        end
        refreshFonts()
 
        Admin.makeLabel(scroll, "👀 Vista previa", UDim2.fromOffset(200, 22), UDim2.fromOffset(12, 228), 17, GOLD)
        updatePreview()
 
        ------------------------------------------------------------
        -- Enviar a / boton enviar
        ------------------------------------------------------------
        Admin.makeLabel(scroll, "Enviar a:", UDim2.fromOffset(200, 22), UDim2.fromOffset(12, 360), 17, GOLD)
 
        local serverBtn, _, serverGrad = makeButton(scroll, {
        Size = UDim2.fromOffset(190, 40), Position = UDim2.fromOffset(110, 404),
        Colors = C.GREEN, Radius = 12, TextSize = 19, Text = "🖥️ Este server", ZIndex = 3,
        })
        local globalBtn, _, globalGrad = makeButton(scroll, {
        Size = UDim2.fromOffset(250, 40), Position = UDim2.fromOffset(350, 404),
        Colors = C.GRAY, Radius = 12, TextSize = 19, Text = "🌍 Global (todos los servers)", ZIndex = 3,
        })
 
        local function setScope(s)
            scope = s
            local a = s == "server" and C.GREEN or C.GRAY
            local b = s == "global" and C.GREEN or C.GRAY
            serverGrad.Color = ColorSequence.new(a[1], a[2])
            globalGrad.Color = ColorSequence.new(b[1], b[2])
        end
        serverBtn.MouseButton1Click:Connect(function() setScope("server") end)
            globalBtn.MouseButton1Click:Connect(function() setScope("global") end)
 
                local sendBtn = makeButton(scroll, {
                Size = UDim2.fromOffset(320, 52), Position = UDim2.fromOffset(286, 480),
                Colors = C.YELLOW, Radius = 14, TextSize = 24, Text = "📢 Enviar mensaje", ZIndex = 3,
                })
 
                sendBtn.MouseButton1Click:Connect(function()
                    local ok, res = pcall(function()
                        return messageRF:InvokeServer({
                        text = msgBox.Text,
                        scope = scope,
                        bg = rgb(selBg),
                        textColor = rgb(selText),
                        font = selFont,
                        })
                    end)
                    if not ok or type(res) ~= "table" then
                        UI.showToast("Error de conexión")
                        return
                    end
                    if res.msg then UI.showToast(res.msg) end
                    if res.ok then
                        msgBox.Text = ""
                    end
                end)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940487000437f</UniqueId>
