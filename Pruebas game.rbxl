<Content name="LinkedSource"><null></null></Content>
<string name="Name">RunAnimation</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
 
local player = Players.LocalPlayer
local treadmills = workspace:WaitForChild("Treadmills")
 
local RUN_R15 = "rbxassetid://913376220"
local RUN_R6 = "rbxassetid://180426354"
 
local function setupCharacter(char)
    local hum = char:WaitForChild("Humanoid")
    local hrp = char:WaitForChild("HumanoidRootPart")
    local animator = hum:WaitForChild("Animator")
 
    local anim = Instance.new("Animation")
    anim.AnimationId = hum.RigType == Enum.HumanoidRigType.R15 and RUN_R15 or RUN_R6
    local track = animator:LoadAnimation(anim)
    track.Looped = true
    track.Priority = Enum.AnimationPriority.Action
 
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char }
 
    while char.Parent and hum.Health > 0 do
        local result = workspace:Raycast(hrp.Position, Vector3.new(0, -8, 0), params)
        local on = result ~= nil and result.Instance:IsDescendantOf(treadmills)
 
        if on then
            if not track.IsPlaying then track:Play() end
            track:AdjustSpeed(math.clamp(hum.WalkSpeed / 16, 1, 3))
        elseif track.IsPlaying then
            track:Stop()
        end
        task.wait(0.1)
    end
end
 
player.CharacterAdded:Connect(setupCharacter)
if player.Character then
    task.spawn(setupCharacter, player.Character)
end

]]></ProtectedString>
