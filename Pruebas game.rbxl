<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UI = require(script.Parent:WaitForChild("UI"))
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local shopRF = ReplicatedStorage:WaitForChild("ShopRequest")
 
local player = Players.LocalPlayer
 
local new, tween, corner, border = UI.new, UI.tween, UI.corner, UI.border
local textStroke, gradient, makeButton = UI.textStroke, UI.gradient, UI.makeButton
local NAVY, WHITE, FONT, COLORS = UI.NAVY, UI.WHITE, UI.FONT, UI.COLORS
local root = UI.root
 
local GRAY = { Color3.fromRGB(150, 156, 175), Color3.fromRGB(90, 96, 120) }
local BLUE = { Color3.fromRGB(100, 190, 255), Color3.fromRGB(40, 110, 230) }
 
local side = root:WaitForChild("Side")
 
local function invoke(action, arg)
    local ok, res = pcall(function()
        return shopRF:InvokeServer(action, arg)
    end)
    return ok and res or { ok = false }
end
 
local function text(parent, props, size, color)
    props.BackgroundTransparency = 1
    props.Font = FONT
    props.TextSize = size
    props.TextColor3 = color or WHITE
    props.RichText = true
    local l = new("TextLabel", props, parent)
    textStroke(l, NAVY, 3)
    return l
end
 
local function fmtTime(s)
    s = math.max(0, math.floor(s))
    return string.format("%02d:%02d:%02d", s // 3600, (s % 3600) // 60, s % 60)
end
 
------------------------------------------------------------
-- FABRICA DE PANELES
------------------------------------------------------------
local panels = {}
 
local function makePanel(name, title, colors, w, h)
    local panel = new("Frame", {
    Name = name, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.46),
    Size = UDim2.fromOffset(w, h), BackgroundColor3 = Color3.fromRGB(58, 62, 74),
    Visible = false, ZIndex = 20,
    }, root)
    corner(panel, 24)
    border(panel, NAVY, 5)
    local scale = new("UIScale", {}, panel)
 
    local header = new("Frame", {
    Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(w - 20, 56),
    BackgroundColor3 = WHITE, ZIndex = 21,
    }, panel)
    corner(header, 16)
    border(header, NAVY, 4)
    gradient(header, colors)
    local t = new("TextLabel", {
    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = UI.TITLE_FONT,
    TextSize = 36, TextColor3 = WHITE, Text = title, ZIndex = 22,
    }, header)
    textStroke(t, NAVY, 4)
 
    local close = makeButton(panel, {
    Name = "Close", Size = UDim2.fromOffset(44, 44), Position = UDim2.new(1, -6, 0, 6),
    Colors = COLORS.RED, Radius = 12, TextSize = 28, Text = "X", ZIndex = 24,
    })
 
    local content = new("Frame", {
    Position = UDim2.fromOffset(12, 76), Size = UDim2.fromOffset(w - 24, h - 90),
    BackgroundColor3 = Color3.fromRGB(36, 40, 50), ZIndex = 21,
    }, panel)
    corner(content, 16)
    border(content, NAVY, 4)
 
    local P = { panel = panel, content = content, isOpen = false }
 
    function P.open()
        for _, other in pairs(panels) do
            if other ~= P and other.isOpen then other.close() end
        end
        P.isOpen = true
        if P.onOpen then P.onOpen() end
        scale.Scale = 0.7
        panel.Visible = true
        tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
    end
    function P.close()
        P.isOpen = false
        tween(scale, 0.15, { Scale = 0.7 })
        task.delay(0.15, function()
            if not P.isOpen then panel.Visible = false end
        end)
    end
    close.MouseButton1Click:Connect(P.close)
    panels[name] = P
    return P
end
 
local function wire(button, P)
    button.MouseButton1Click:Connect(function()
        if P.isOpen then P.close() else P.open() end
    end)
end
 
------------------------------------------------------------
-- TRAILS
------------------------------------------------------------
local trails = makePanel("TrailsPanel", "TRAILS", { Color3.fromRGB(190, 120, 255), Color3.fromRGB(110, 50, 215) }, 560, 450)
local list = new("ScrollingFrame", {
Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 1, -16),
BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6,
AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ZIndex = 22,
}, trails.content)
new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, list)
 
local function refreshTrails()
    for _, c in ipairs(list:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    local owned = {}
    for id in string.gmatch(player:GetAttribute("OwnedTrails") or "", "[^,]+") do
        owned[id] = true
    end
    local equipped = player:GetAttribute("EquippedTrail") or ""
 
    for i, t in ipairs(Config.Trails) do
        local row = new("Frame", {
        LayoutOrder = i, Size = UDim2.new(1, -6, 0, 70), BackgroundColor3 = Color3.fromRGB(58, 64, 82), ZIndex = 23,
        }, list)
        corner(row, 14)
        border(row, NAVY, 3)
 
        local sw = new("Frame", {
        Position = UDim2.fromOffset(10, 11), Size = UDim2.fromOffset(48, 48), BackgroundColor3 = WHITE, ZIndex = 24,
        }, row)
        corner(sw, 10)
        border(sw, NAVY, 3)
        new("UIGradient", { Color = ColorSequence.new(t.Color1, t.Color2), Rotation = 45 }, sw)
 
        text(row, { Position = UDim2.fromOffset(70, 6), Size = UDim2.fromOffset(260, 32),
        TextXAlignment = Enum.TextXAlignment.Left, Text = t.Name, ZIndex = 24 }, 24)
        text(row, { Position = UDim2.fromOffset(70, 36), Size = UDim2.fromOffset(260, 26),
        TextXAlignment = Enum.TextXAlignment.Left, Text = "Multiplier x" .. UI.fmtMult(t.Mult), ZIndex = 24 }, 17, Color3.fromRGB(185, 255, 190))
 
        local colors, caption, action, arg = COLORS.GREEN, "🏆 " .. UI.abbr(t.Cost), "trail_buy", t.Id
        if owned[t.Id] then
            if equipped == t.Id then
                colors, caption, action, arg = GRAY, "Unequip", "trail_equip", ""
            else
                colors, caption, action, arg = BLUE, "Equip", "trail_equip", t.Id
            end
        end
        local btn = makeButton(row, {
        Size = UDim2.fromOffset(128, 46), Position = UDim2.new(1, -78, 0.5, 0),
        Colors = colors, Radius = 12, TextSize = 22, Text = caption, ZIndex = 25,
        })
        btn.MouseButton1Click:Connect(function()
            invoke(action, arg)
        end)
    end
end
trails.onOpen = refreshTrails
for _, a in ipairs({ "OwnedTrails", "EquippedTrail" }) do
    player:GetAttributeChangedSignal(a):Connect(function()
        if trails.isOpen then refreshTrails() end
    end)
end
wire(side:WaitForChild("TrailsBtn"), trails)
 
------------------------------------------------------------
-- DAILY
------------------------------------------------------------
local daily = makePanel("DailyPanel", "DAILY REWARD", { Color3.fromRGB(255, 232, 90), Color3.fromRGB(255, 150, 0) }, 640, 360)
local cells = {}
for i, reward in ipairs(Config.Daily) do
    local cell = new("Frame", {
    Position = UDim2.fromOffset(12 + (i - 1) * 84, 14), Size = UDim2.fromOffset(78, 120),
    BackgroundColor3 = Color3.fromRGB(58, 64, 82), ZIndex = 22,
    }, daily.content)
    corner(cell, 12)
    border(cell, NAVY, 3)
    text(cell, { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 6), Text = "Day " .. i, ZIndex = 23 }, 17)
    Config.addIcon(cell, "Wins", "🏆", UDim2.fromOffset(40, 40), UDim2.new(0.5, 0, 0, 52), 24)
    text(cell, { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 82), Text = "+" .. UI.abbr(reward), ZIndex = 23 }, 20, Color3.fromRGB(255, 226, 90))
    cells[i] = cell
end
local dailyBtn, dailyLabel, dailyGrad = makeButton(daily.content, {
Size = UDim2.fromOffset(300, 64), Position = UDim2.new(0.5, 0, 0, 190),
Colors = COLORS.GREEN, Radius = 16, TextSize = 26, Text = "CLAIM", ZIndex = 23,
})
text(daily.content, { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 232),
Text = "Come back every day! Miss a day and the streak restarts.", ZIndex = 23 }, 15)
 
local function dailyState()
    local now = workspace:GetServerTimeNow()
    local last = player:GetAttribute("DailyLast") or 0
    local streak = player:GetAttribute("DailyStreak") or 0
    local day = (last > 0 and now - last > 172800) and 1 or (streak % #Config.Daily) + 1
    local wait = last > 0 and (last + 86400 - now) or 0
    return day, wait
end
 
local function refreshDaily()
    local day, wait = dailyState()
    for i, cell in ipairs(cells) do
        local st = cell:FindFirstChildOfClass("UIStroke")
        st.Color = (i == day) and Color3.fromRGB(255, 226, 90) or NAVY
        st.Thickness = (i == day) and 5 or 3
        cell.BackgroundColor3 = (i < day) and Color3.fromRGB(40, 90, 55) or Color3.fromRGB(58, 64, 82)
    end
    if wait <= 0 then
        dailyGrad.Color = ColorSequence.new(COLORS.GREEN[1], COLORS.GREEN[2])
        dailyLabel.Text = "CLAIM DAY " .. day
    else
        dailyGrad.Color = ColorSequence.new(GRAY[1], GRAY[2])
        dailyLabel.Text = fmtTime(wait)
    end
end
daily.onOpen = refreshDaily
dailyBtn.MouseButton1Click:Connect(function()
    invoke("daily")
end)
wire(side:WaitForChild("DailyBtn"), daily)
 
------------------------------------------------------------
-- FREE
------------------------------------------------------------
local free = makePanel("FreePanel", "FREE GIFT", { Color3.fromRGB(120, 240, 95), Color3.fromRGB(38, 178, 58) }, 460, 330)
Config.addIcon(free.content, "Free", "🎁", UDim2.fromOffset(90, 90), UDim2.new(0.5, 0, 0, 62), 23)
text(free.content, { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 118),
Text = "+" .. Config.Free.Wins .. " Wins  &  free Speed!", ZIndex = 23 }, 22, Color3.fromRGB(255, 226, 90))
text(free.content, { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 150),
Text = "A new gift every " .. math.floor(Config.Free.Cooldown / 60) .. " minutes", ZIndex = 23 }, 16)
local freeBtn, freeLabel, freeGrad = makeButton(free.content, {
Size = UDim2.fromOffset(280, 64), Position = UDim2.new(0.5, 0, 0, 205),
Colors = COLORS.GREEN, Radius = 16, TextSize = 26, Text = "CLAIM", ZIndex = 23,
})
 
local function refreshFree()
    local wait = (player:GetAttribute("FreeLast") or 0) + Config.Free.Cooldown - workspace:GetServerTimeNow()
    if wait <= 0 then
        freeGrad.Color = ColorSequence.new(COLORS.GREEN[1], COLORS.GREEN[2])
        freeLabel.Text = "CLAIM!"
    else
        freeGrad.Color = ColorSequence.new(GRAY[1], GRAY[2])
        freeLabel.Text = fmtTime(wait)
    end
end
free.onOpen = refreshFree
freeBtn.MouseButton1Click:Connect(function()
    invoke("free")
end)
wire(side:WaitForChild("FreeBtn"), free)
 
------------------------------------------------------------
-- ADJUST SPEED
------------------------------------------------------------
local adjust = makePanel("AdjustPanel", "ADJUST SPEED", { Color3.fromRGB(190, 120, 255), Color3.fromRGB(120, 50, 215) }, 520, 320)
local adjInfo = text(adjust.content, { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 14), Text = "", ZIndex = 23 }, 34)
text(adjust.content, { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 60),
Text = "Choose how fast you walk (your speed stays saved)", ZIndex = 23 }, 15)
 
local function setPct(p)
    invoke("speedpct", p)
end
 
local minus = makeButton(adjust.content, {
Size = UDim2.fromOffset(70, 60), Position = UDim2.new(0.5, -150, 0, 125),
Colors = COLORS.RED, Radius = 14, TextSize = 36, Text = "-", ZIndex = 23,
})
local plus = makeButton(adjust.content, {
Size = UDim2.fromOffset(70, 60), Position = UDim2.new(0.5, 150, 0, 125),
Colors = COLORS.GREEN, Radius = 14, TextSize = 36, Text = "+", ZIndex = 23,
})
local pctLabel = text(adjust.content, { Size = UDim2.fromOffset(180, 60), Position = UDim2.new(0.5, -90, 0, 95), Text = "", ZIndex = 23 }, 36)
minus.MouseButton1Click:Connect(function()
    setPct((player:GetAttribute("SpeedPct") or 100) - 5)
end)
plus.MouseButton1Click:Connect(function()
    setPct((player:GetAttribute("SpeedPct") or 100) + 5)
end)
 
for i, pct in ipairs({ 10, 25, 50, 75, 100 }) do
    local b = makeButton(adjust.content, {
    Size = UDim2.fromOffset(82, 52), Position = UDim2.new(0.5, (i - 3) * 92, 0, 230),
    Colors = BLUE, Radius = 12, TextSize = 22, Text = pct .. "%", ZIndex = 23,
    })
    b.MouseButton1Click:Connect(function()
        setPct(pct)
    end)
end
 
local function refreshAdjust()
    local pct = player:GetAttribute("SpeedPct") or 100
    local speed = player:GetAttribute("Speed") or 16
    adjInfo.Text = "Speed: " .. math.max(1, math.floor(speed * pct / 100)) .. " / " .. math.floor(speed)
    pctLabel.Text = pct .. "%"
end
for _, a in ipairs({ "SpeedPct", "Speed" }) do
    player:GetAttributeChangedSignal(a):Connect(refreshAdjust)
end
adjust.onOpen = refreshAdjust
refreshAdjust()
wire(side:WaitForChild("AdjustBtn"), adjust)
 
------------------------------------------------------------
-- Refresca los contadores mientras el panel esta abierto
------------------------------------------------------------
task.spawn(function()
    while true do
        task.wait(1)
        if daily.isOpen then refreshDaily() end
        if free.isOpen then refreshFree() end
    end
end)

]]></ProtectedString>
