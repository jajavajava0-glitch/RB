<Item class="ModuleScript" referent="RBX6A5AB5395EC24443840DD04917C34F7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Config</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[local Config = {}

------------------------------------------------------------
-- ★ ICONOS ★  Pega SOLO el número de tu imagen entre las comillas.
-- Si lo dejas vacío "" se usa un emoji en su lugar.
------------------------------------------------------------
Config.Icons = {
Wins = "12129301834",         -- trofeo de las wins (pastilla de arriba y botones de abajo)
Speed = "",        -- rayo / tenis de los botones de speed
Rebirth = "",      -- botón Rebirth
Trails = "",       -- botón Trails
Daily = "",        -- botón Daily
Free = "",         -- botón FREE!
AdjustSpeed = "",  -- rayo del botón Adjust Speed
Multiplier = "",   -- iconito arriba del "1x Multiplier"
Crown = "",        -- corona de los pases
Hammer = "",       -- martillo del admin panel
}

------------------------------------------------------------
-- ★ PASES (Game Pass) ★
-- Id = número de tu Game Pass (0 = todavía no existe, avisa "Próximamente")
-- Price = lo que dice el botón (solo texto)   Mult = cuánto multiplica
------------------------------------------------------------
Config.Passes = {
Speed = { Id = 0, Price = 99, Mult = 2 },   -- 2x Speed (multiplica el speed/XP)
Wins = { Id = 0, Price = 99, Mult = 2 },    -- 2x Wins
}

------------------------------------------------------------
-- ★ BOTONES DE ABAJO (Developer Products) ★
-- Kind = "Wins"  -> da Amount wins
-- Kind = "Speed" -> da lo que ganarías farmeando Seconds segundos
--                   en tu mejor caminadora
-- Color: GREEN, ORANGE, PURPLE, PINK, RED, BLUE, YELLOW
------------------------------------------------------------
Config.Products = {
{ Kind = "Wins", Amount = 100, Id = 0, Color = "GREEN" },
{ Kind = "Wins", Amount = 600, Id = 0, Color = "ORANGE" },
{ Kind = "Speed", Seconds = 600, Id = 0, Color = "PURPLE" },
}
Config.BestTreadmillMult = 16 -- el Multiplier de tu mejor caminadora

------------------------------------------------------------
-- ★ DAILY (recompensa diaria, ciclo de 7 días, en wins) ★
------------------------------------------------------------
Config.Daily = { 5, 10, 20, 40, 75, 120, 250 }

------------------------------------------------------------
-- ★ FREE! (regalo gratis cada cierto tiempo) ★
------------------------------------------------------------
Config.Free = {
Cooldown = 600,      -- segundos entre regalos (600 = 10 min)
Wins = 5,            -- wins que da
SpeedSeconds = 120,  -- + lo que farmearías en 120 s en tu mejor caminadora
}

------------------------------------------------------------
-- ★ TRAILS ★
-- Id: nombre único sin espacios ni comas
-- Cost: wins    Mult: multiplica tu speed/XP mientras lo tengas puesto
-- Color1 -> Color2: degradado de la estela
-- Texture: ID de tu textura ("" = sin textura)
-- Lifetime: lo largo que dura la estela    Width: lo ancha que es
-- Para añadir uno nuevo copia una línea { ... }, y cámbiale el Id
------------------------------------------------------------
Config.Trails = {
{ Id = "rojo", Name = "Fire Red", Cost = 50, Mult = 1.1,
Color1 = Color3.fromRGB(255, 70, 70), Color2 = Color3.fromRGB(255, 190, 90),
Texture = "", Lifetime = 0.7, Width = 1.6 },
{ Id = "azul", Name = "Ocean Blue", Cost = 150, Mult = 1.2,
Color1 = Color3.fromRGB(60, 130, 255), Color2 = Color3.fromRGB(120, 240, 255),
Texture = "", Lifetime = 0.8, Width = 1.8 },
{ Id = "verde", Name = "Toxic Green", Cost = 400, Mult = 1.35,
Color1 = Color3.fromRGB(60, 220, 80), Color2 = Color3.fromRGB(220, 255, 90),
Texture = "", Lifetime = 0.9, Width = 2 },
{ Id = "dorado", Name = "Gold Rush", Cost = 1000, Mult = 1.5,
Color1 = Color3.fromRGB(255, 200, 40), Color2 = Color3.fromRGB(255, 245, 160),
Texture = "", Lifetime = 1, Width = 2.2 },
{ Id = "arcoiris", Name = "Rainbow", Cost = 2500, Mult = 1.75,
Color1 = Color3.fromRGB(255, 90, 200), Color2 = Color3.fromRGB(90, 220, 255),
Texture = "", Lifetime = 1.1, Width = 2.4 },
{ Id = "galaxia", Name = "Galaxy", Cost = 6000, Mult = 2,
Color1 = Color3.fromRGB(150, 70, 255), Color2 = Color3.fromRGB(40, 20, 140),
Texture = "", Lifetime = 1.3, Width = 2.6 },
}

------------------------------------------------------------
-- (de aquí para abajo NO toques nada)
------------------------------------------------------------
function Config.assetId(v)
    v = tostring(v or "")
    if v == "" or v == "0" then return nil end
    if v:match("^%d+$") then return "rbxassetid://" .. v end
    return v
end

function Config.getTrail(id)
    for _, t in ipairs(Config.Trails) do
        if t.Id == id then return t end
    end
    return nil
end

-- Pone un icono (imagen si hay ID, si no un emoji)
function Config.addIcon(parent, key, emoji, size, position, zindex)
    local id = Config.assetId(Config.Icons[key])
    local o
    if id then
        o = Instance.new("ImageLabel")
        o.Image = id
        o.ScaleType = Enum.ScaleType.Fit
    else
        o = Instance.new("TextLabel")
        o.Text = emoji
        o.TextScaled = true
        o.Font = Enum.Font.FredokaOne
    end
    o.BackgroundTransparency = 1
    o.AnchorPoint = Vector2.new(0.5, 0.5)
    o.Position = position
    o.Size = size
    o.ZIndex = zindex or 3
    o.Parent = parent
    return o
end

return Config

]]></ProtectedString>
