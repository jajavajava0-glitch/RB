<Item class="Script" referent="RBX66C1625455D04AC580D8104549513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local modelo = script.Parent
local pared1 = modelo:WaitForChild("Pared1")
local pared2 = modelo:WaitForChild("Pared2")

-- Guardamos las posiciones originales de cada pared
local posOriginal1 = pared1.Position
local posOriginal2 = pared2.Position

-- Calculamos el punto medio exacto entre las dos paredes
local centro = (posOriginal1 + posOriginal2) / 2

-- Calculamos la dirección hacia el centro para saber dónde parar antes de que se atraviesen
local direccion = (posOriginal2 - posOriginal1).Unit
local mitadAncho1 = pared1.Size.X / 2
local mitadAncho2 = pared2.Size.X / 2

-- NOTA: Si tus paredes chocan por el lado Z en vez del X, cambia .X por .Z en las dos líneas de arriba

-- Posiciones finales donde chocarán cara a cara en el centro
local destino1 = centro - (direccion * mitadAncho1)
local destino2 = centro + (direccion * mitadAncho2)

-- Función opcional para que eliminen al jugador SOLO mientras se están cerrando
local cerrando = false

local function alTocar(hit)
    if cerrando then
        local humanoide = hit.Parent:FindFirstChild("Humanoid")
        if humanoide then
            humanoide.Health = 0
        end
    end
end

pared1.Touched:Connect(alTocar)
pared2.Touched:Connect(alTocar)

-- Bucle principal de la trampa
while true do
    -- 1. Espera 5 segundos abierta
    task.wait(5)
    
    -- 2. Se cierran de golpe (0.4 segundos)
    cerrando = true
    local tiempoCierre = 0.4
    local t = 0
    
    while t < tiempoCierre do
        local delta = task.wait()
        t = t + delta
        local alfa = math.clamp(t / tiempoCierre, 0, 1)
        
        pared1.Position = posOriginal1:Lerp(destino1, alfa)
        pared2.Position = posOriginal2:Lerp(destino2, alfa)
    end
    cerrando = false
    
    -- 3. Se quedan cerradas 1.5 segundos
    task.wait(1.5)
    
    -- 4. Se abren lentamente (1.2 segundos)
    local tiempoApertura = 1.2
    t = 0
    
    while t < tiempoApertura do
        local delta = task.wait()
        t = t + delta
        local alfa = math.clamp(t / tiempoApertura, 0, 1)
        
        pared1.Position = destino1:Lerp(posOriginal1, alfa)
        pared2.Position = destino2:Lerp(posOriginal2, alfa)
    end
end


]]></ProtectedString>
