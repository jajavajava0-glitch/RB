<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Admin = require(script.Parent:WaitForChild("AdminCore"))
local UI = require(script.Parent:WaitForChild("UI"))

local player = Players.LocalPlayer

local new, corner, border, gradient = UI.new, UI.corner, UI.border, UI.gradient
local makeButton = UI.makeButton
local WHITE, GOLD = UI.WHITE, UI.GOLD
local C = Admin.COLORS
local LINE = Admin.LINE
local GRAYTEXT = Color3.fromRGB(190, 198, 220)

local adminPage = Admin.pages.Admins

local listFrame = new("ScrollingFrame", {
Position = UDim2.fromOffset(16, 14),
Size = UDim2.fromOffset(300, 256),
BackgroundColor3 = Color3.fromRGB(46, 50, 63),
BorderSizePixel = 0,
ScrollBarThickness = 6,
CanvasSize = UDim2.new(),
AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, adminPage)
corner(listFrame, 12)
border(listFrame, LINE, 3)
new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, listFrame)
new("UIPadding", {
PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
}, listFrame)

local addBox = Admin.makeBox(adminPage, "Usuario de Roblox...", UDim2.fromOffset(224, 38), UDim2.fromOffset(332, 14))
local addBtn = makeButton(adminPage, {
Size = UDim2.fromOffset(224, 44), Position = UDim2.fromOffset(444, 82),
Colors = C.GREEN, Radius = 12, TextSize = 21, Text = "➕ Añadir admin", ZIndex = 3,
})
Admin.makeLabel(adminPage,
"👑 Solo el dueño puede añadir o quitar admins. Los admins pueden usar Dar, Tags y Mensajes.",
UDim2.fromOffset(224, 130), UDim2.fromOffset(332, 116), 15, GRAYTEXT)

local function renderList(list)
    for _, c in ipairs(listFrame:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    local owner = Admin.isOwner()
    
    addBox.TextEditable = owner
    addBtn.Visible = owner
    
    for i, entry in ipairs(list) do
        local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = WHITE,
        LayoutOrder = i,
        }, listFrame)
        corner(row, 10)
        border(row, LINE, 3)
        gradient(row, { Color3.fromRGB(70, 76, 96), Color3.fromRGB(52, 57, 74) })
        
        Admin.makeLabel(row, (entry.owner and "👑 " or "👤 ") .. entry.name,
        UDim2.new(1, -96, 1, 0), UDim2.fromOffset(10, 0), 18)
        
        if entry.owner then
            Admin.makeLabel(row, "DUEÑO", UDim2.fromOffset(70, 40), UDim2.new(1, -76, 0, 0), 14, GOLD,
            Enum.TextXAlignment.Right)
        elseif owner then
            local rm = makeButton(row, {
            Size = UDim2.fromOffset(76, 28), Position = UDim2.new(1, -46, 0.5, 0),
            Colors = C.RED, Radius = 8, TextSize = 16, Text = "Quitar", ZIndex = 3,
            })
            rm.MouseButton1Click:Connect(function()
                local res = Admin.request("admin_remove", { userId = entry.userId })
                if res.ok and res.admins then renderList(res.admins) end
            end)
        end
    end
end

local function refreshAdmins()
    local res = Admin.request("admin_list")
    if res.ok and res.admins then
        renderList(res.admins)
    end
end
Admin.tabOpened.Admins = refreshAdmins

addBtn.MouseButton1Click:Connect(function()
    local res = Admin.request("admin_add", { name = addBox.Text })
    if res.ok then
        addBox.Text = ""
        if res.admins then renderList(res.admins) end
    end
end)

player:GetAttributeChangedSignal("IsOwner"):Connect(function()
    if adminPage.Visible then refreshAdmins() end
end)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940486600437f</UniqueId>
</Properties>
</Item>
