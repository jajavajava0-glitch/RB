<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454104891AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">HUD</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UI = require(script.Parent:WaitForChild("UI"))
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local shopRF = ReplicatedStorage:WaitForChild("ShopRequest")

------------------------------------------------------------
-- ★ AQUI CAMBIAS COLORES, TAMAÑOS Y LETRA ★
------------------------------------------------------------
local STYLE = {
BAR_LEFT = Color3.fromRGB(30, 170, 255),     -- inicio del degradado (azul)
BAR_RIGHT = Color3.fromRGB(45, 235, 85),     -- final del degradado (verde)
BAR_STUDS = Color3.fromRGB(255, 255, 255),   -- cuadritos de la parte llena
BAR_EMPTY = Color3.fromRGB(150, 150, 152),   -- parte vacía (gris)
BAR_EMPTY_STUDS = Color3.fromRGB(115, 115, 118),
BAR_BORDER = Color3.fromRGB(12, 14, 20),     -- borde negro

FONT = Enum.Font.FredokaOne,
TEXT_COLOR = Color3.fromRGB(255, 255, 255),
OUTLINE = Color3.fromRGB(10, 12, 18),
OUTLINE_THICKNESS = 3,

LABEL_GAMEPASS = Color3.fromRGB(255, 190, 70),  -- "Multiplier x1 (Gamepass)"
LABEL_REBIRTH = Color3.fromRGB(110, 255, 130),  -- "Multiplier x8 (Rebirth)"
LABEL_TRAILS = Color3.fromRGB(185, 100, 255),   -- "Multiplier x1 (Trails)"

LEVEL_SIZE = 28,
NUM_SIZE = 26,
SPEED_SIZE = 30,
LABEL_SIZE = 13,

-- Número grande de arriba: "Total" = todo el speed que has ganado
-- "Walk" = tu velocidad real al caminar
TOP_NUMBER = "Total",
}

local BAR_W = 600

------------------------------------------------------------
local player = Players.LocalPlayer
local ls = player:WaitForChild("leaderstats")
local levelValue = ls:WaitForChild("Level")
local winsValue = ls:WaitForChild("Wins")

local new, tween, corner, border = UI.new, UI.tween, UI.corner, UI.border
local WHITE, GOLD, NAVY, COLORS = UI.WHITE, UI.GOLD, UI.NAVY, UI.COLORS
local textStroke = UI.textStroke
local root = UI.root

local PALETTE = {
GREEN = COLORS.GREEN, RED = COLORS.RED, YELLOW = COLORS.YELLOW, PURPLE = COLORS.PURPLE,
ORANGE = { Color3.fromRGB(255, 200, 70), Color3.fromRGB(240, 120, 20) },
BLUE = { Color3.fromRGB(100, 190, 255), Color3.fromRGB(40, 110, 230) },
PINK = { Color3.fromRGB(255, 130, 220), Color3.fromRGB(200, 40, 160) },
}

local function styleText(label, size, color)
    label.Font = STYLE.FONT
    label.TextSize = size
    label.TextColor3 = color
    label.BackgroundTransparency = 1
    textStroke(label, STYLE.OUTLINE, STYLE.OUTLINE_THICKNESS)
    return label
end

local function invoke(action, arg)
    pcall(function()
        shopRF:InvokeServer(action, arg)
    end)
end

------------------------------------------------------------
-- BARRA DE ABAJO
------------------------------------------------------------
local hud = new("Frame", {
Name = "BottomHUD",
AnchorPoint = Vector2.new(0.5, 1),
Position = UDim2.new(0.5, 0, 1, -10),
Size = UDim2.fromOffset(BAR_W, 176),
BackgroundTransparency = 1,
}, root)

local speedLabel = styleText(new("TextLabel", {
Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(BAR_W, 36), Text = "",
}, hud), STYLE.SPEED_SIZE, STYLE.TEXT_COLOR)

local function miniLabel(y, align, color)
    return styleText(new("TextLabel", {
    Position = UDim2.fromOffset(4, y), Size = UDim2.fromOffset(BAR_W - 8, 18),
    TextXAlignment = align, Text = "",
    }, hud), STYLE.LABEL_SIZE, color)
end
local gamepassLabel = miniLabel(24, Enum.TextXAlignment.Left, STYLE.LABEL_GAMEPASS)
local rebirthLabel = miniLabel(8, Enum.TextXAlignment.Right, STYLE.LABEL_REBIRTH)
local trailsLabel = miniLabel(24, Enum.TextXAlignment.Right, STYLE.LABEL_TRAILS)

local barOuter = new("Frame", {
Position = UDim2.fromOffset(0, 46),
Size = UDim2.fromOffset(BAR_W, 52),
BackgroundColor3 = STYLE.BAR_BORDER,
}, hud)
corner(barOuter, 18)
local barScale = new("UIScale", { Scale = 1 }, barOuter)

local track = new("Frame", {
Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(BAR_W - 8, 44),
BackgroundColor3 = STYLE.BAR_EMPTY, ClipsDescendants = true,
}, barOuter)
corner(track, 14)

local function addStuds(parent, color, transparency)
    for c = 0, math.floor(BAR_W / 22) do
        for r = 0, 1 do
            local s = new("Frame", {
            Position = UDim2.fromOffset(c * 22 + 6, 7 + r * 20),
            Size = UDim2.fromOffset(12, 12),
            BackgroundColor3 = color, BackgroundTransparency = transparency,
            BorderSizePixel = 0,
            }, parent)
            corner(s, 3)
            border(s, color, 2).Transparency = transparency
        end
    end
end
addStuds(track, STYLE.BAR_EMPTY_STUDS, 0.3)

local fill = new("Frame", {
Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE,
BorderSizePixel = 0, ClipsDescendants = true,
}, track)
corner(fill, 14)
new("UIGradient", {
Color = ColorSequence.new(STYLE.BAR_LEFT, STYLE.BAR_RIGHT), Rotation = 0,
}, fill)
addStuds(fill, STYLE.BAR_STUDS, 0.82)

local levelText = styleText(new("TextLabel", {
Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(BAR_W / 2, 52), ZIndex = 6, Text = "",
}, barOuter), STYLE.LEVEL_SIZE, STYLE.TEXT_COLOR)

local numText = styleText(new("TextLabel", {
Position = UDim2.fromOffset(BAR_W / 2, 0), Size = UDim2.fromOffset(BAR_W / 2, 52), ZIndex = 6, Text = "",
}, barOuter), STYLE.NUM_SIZE, STYLE.TEXT_COLOR)

------------------------------------------------------------
-- 3 BOTONES DE ABAJO (salen de Config.Products)
------------------------------------------------------------
local productLabels = {}
for i, p in ipairs(Config.Products) do
    local btn, label = UI.makeButton(hud, {
    Name = "Product" .. i,
    Size = UDim2.fromOffset(184, 66),
    Position = UDim2.new(0.5, (i - 2) * 194, 0, 136),
    Colors = PALETTE[p.Color] or COLORS.GREEN,
    Radius = 16, TextSize = 28, ZIndex = 2,
    })
    label.Position = UDim2.fromScale(0.26, 0)
    label.Size = UDim2.fromScale(0.74, 1)
    local iconKey = p.Kind == "Wins" and "Wins" or "Speed"
    Config.addIcon(btn, iconKey, p.Kind == "Wins" and "🏆" or "⚡", UDim2.fromOffset(46, 46), UDim2.new(0, 34, 0.5, 0), 4)
    productLabels[i] = label
    btn.MouseButton1Click:Connect(function()
        invoke("buy_product", i)
    end)
end

local function updateProducts()
    local perSec = player:GetAttribute("XPPerSecond") or 0
    for i, p in ipairs(Config.Products) do
        if p.Kind == "Wins" then
            productLabels[i].Text = "+" .. UI.abbr(p.Amount)
        else
            local amount = perSec * Config.BestTreadmillMult * p.Seconds
            productLabels[i].Text = '+' .. UI.abbr(amount) .. "\nSPEED"
        end
    end
end

------------------------------------------------------------
-- COLUMNA IZQUIERDA
------------------------------------------------------------
local side = new("Frame", {
Name = "Side", Position = UDim2.fromOffset(14, 0),
Size = UDim2.new(0, 220, 1, 0), BackgroundTransparency = 1,
}, root)

-- Pastilla de wins
local winsPill = new("Frame", {
Position = UDim2.fromOffset(0, 104), Size = UDim2.fromOffset(230, 54), BackgroundColor3 = WHITE,
}, side)
corner(winsPill, 27)
border(winsPill, Color3.fromRGB(70, 40, 0), 4)
new("UIGradient", {
Color = ColorSequence.new(Color3.fromRGB(235, 170, 50), Color3.fromRGB(150, 90, 15)), Rotation = 90,
}, winsPill)
Config.addIcon(winsPill, "Wins", "🏆", UDim2.fromOffset(52, 52), UDim2.fromOffset(28, 27), 4)
local winsText = styleText(new("TextLabel", {
Position = UDim2.fromOffset(56, 0), Size = UDim2.fromOffset(120, 54), Text = "0",
TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3,
}, winsPill), 30, WHITE)
local plusBtn = UI.makeButton(winsPill, {
Name = "WinsPlus", Size = UDim2.fromOffset(38, 38), Position = UDim2.fromOffset(200, 27),
Colors = PALETTE.YELLOW, Radius = 19, TextSize = 30, Text = "+", ZIndex = 4,
})
plusBtn.MouseButton1Click:Connect(function()
    invoke("buy_product", 1)
end)

local function addDot(button)
    local dot = new("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -6, 0, 6),
    Size = UDim2.fromOffset(26, 26), BackgroundColor3 = Color3.fromRGB(255, 60, 60),
    Visible = false, ZIndex = 8,
    }, button)
    corner(dot, 13)
    border(dot, WHITE, 3)
    new("TextLabel", {
    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
    Font = STYLE.FONT, TextSize = 18, TextColor3 = WHITE, Text = "!", ZIndex = 9,
    }, dot)
    return dot
end

local function tile(parent, name, caption, colors, iconKey, emoji, x, y)
    local b = UI.makeButton(parent, {
    Name = name, Size = UDim2.fromOffset(86, 86),
    Position = UDim2.fromOffset(x + 43, y + 43),
    Colors = colors, Radius = 18, ZIndex = 2,
    })
    Config.addIcon(b, iconKey, emoji, UDim2.fromOffset(46, 46), UDim2.new(0.5, 0, 0.4, 0), 4)
    styleText(new("TextLabel", {
    Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -26), ZIndex = 5, Text = caption,
    }, b), 17, WHITE)
    return b
end

-- Rebirth (RebirthPanel busca exactamente Side > RebirthHolder > RebirthIcon)
local rebirthHolder = new("Frame", {
Name = "RebirthHolder", Position = UDim2.fromOffset(0, 172),
Size = UDim2.fromOffset(86, 86), BackgroundTransparency = 1,
}, side)
tile(rebirthHolder, "RebirthIcon", "Rebirth", PALETTE.BLUE, "Rebirth", "🔄", 0, 0)

tile(side, "TrailsBtn", "Trails", PALETTE.PURPLE, "Trails", "🌈", 96, 172)
local dailyBtn = tile(side, "DailyBtn", "Daily", PALETTE.YELLOW, "Daily", "📅", 0, 268)
local freeBtn = tile(side, "FreeBtn", "FREE!", PALETTE.GREEN, "Free", "🎁", 96, 268)
local dailyDot, freeDot = addDot(dailyBtn), addDot(freeBtn)

-- Adjust Speed
local adjustBtn, adjustLabel = UI.makeButton(side, {
Name = "AdjustBtn", Size = UDim2.fromOffset(182, 70), Position = UDim2.fromOffset(91, 399),
Colors = PALETTE.PURPLE, Radius = 18, ZIndex = 2,
})
adjustLabel.Position = UDim2.fromScale(0.22, 0)
adjustLabel.Size = UDim2.fromScale(0.78, 1)
Config.addIcon(adjustBtn, "AdjustSpeed", "⚡", UDim2.fromOffset(40, 40), UDim2.new(0, 28, 0.42, 0), 4)

-- Insignia "1x Multiplier (REBIRTH)"
local badge = new("Frame", {
Position = UDim2.fromOffset(0, 490), Size = UDim2.fromOffset(182, 76), BackgroundColor3 = WHITE,
}, side)
corner(badge, 22)
border(badge, NAVY, 4)
new("UIGradient", {
Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 205, 255)), Rotation = 90,
}, badge)
Config.addIcon(badge, "Multiplier", "👥", UDim2.fromOffset(40, 40), UDim2.new(0.5, 0, 0, -6), 4)
local badgeText = styleText(new("TextLabel", {
Size = UDim2.fromScale(1, 1), RichText = true, Text = "", ZIndex = 3,
}, badge), 22, WHITE)

------------------------------------------------------------
-- COLUMNA DERECHA: PASES
------------------------------------------------------------
local function passButton(key, title, colors, y)
    local p = Config.Passes[key]
    local btn, label = UI.makeButton(root, {
    Name = "Pass" .. key, Size = UDim2.fromOffset(210, 72),
    Position = UDim2.new(1, -124, 0, y), Colors = colors, Radius = 18, ZIndex = 2,
    })
    label.Position = UDim2.fromScale(0.3, 0)
    label.Size = UDim2.fromScale(0.7, 1)
    Config.addIcon(btn, "Crown", "👑", UDim2.fromOffset(50, 50), UDim2.new(0, 32, 0.5, 0), 4)
    btn.MouseButton1Click:Connect(function()
        invoke("buy_pass", key)
    end)
    return function()
        local owned = (player:GetAttribute("Pass" .. key) or 1) > 1
        if owned then
            label.Text = '' .. title .. '\nOWNED ✓'
        else
            label.Text = '' .. title .. '\nONLY ' .. p.Price .. "!"
        end
    end
end
local updatePassSpeed = passButton("Speed", Config.Passes.Speed.Mult .. "x Speed", PALETTE.ORANGE, 210)
local updatePassWins = passButton("Wins", Config.Passes.Wins.Mult .. "x Wins", PALETTE.PURPLE, 296)

------------------------------------------------------------
-- ACTUALIZAR
------------------------------------------------------------
local lastLevel = levelValue.Value

local function updateHUD()
    local xp = player:GetAttribute("XP") or 0
    local need = math.max(player:GetAttribute("XPNeeded") or 1, 1)
    local speed = player:GetAttribute("Speed") or 16
    local total = player:GetAttribute("Total") or 0
    local pct = (player:GetAttribute("SpeedPct") or 100) / 100
    local rebirthMult = player:GetAttribute("XPMultiplier") or 1
    local passMult = player:GetAttribute("PassSpeed") or 1
    local trailMult = player:GetAttribute("TrailMult") or 1
    local level = levelValue.Value
    
    tween(fill, 0.18, { Size = UDim2.fromScale(math.clamp(xp / need, 0, 1), 1) })
    
    levelText.Text = "Level " .. level
    numText.Text = UI.abbr(xp) .. " / " .. UI.abbr(need)
    local top = STYLE.TOP_NUMBER == "Walk" and math.floor(speed * pct) or total
    speedLabel.Text = UI.abbr(top) .. " Speed"
    gamepassLabel.Text = "Multiplier x" .. UI.fmtMult(passMult) .. " (Gamepass)"
    rebirthLabel.Text = "Multiplier x" .. UI.fmtMult(rebirthMult) .. " (Rebirth)"
    trailsLabel.Text = "Multiplier x" .. UI.fmtMult(trailMult) .. " (Trails)"
    
    winsText.Text = UI.abbr(winsValue.Value)
    adjustLabel.Text = '0-' .. UI.abbr(speed) .. '\nAdjust Speed'
    badgeText.Text = '' .. UI.fmtMult(rebirthMult) .. 'x Multiplier\n(REBIRTH)'
    
    updateProducts()
    
    if level > lastLevel then
        barScale.Scale = 1.05
        tween(barScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
    end
    lastLevel = level
end

for _, attr in ipairs({ "XP", "XPNeeded", "XPPerSecond", "Speed", "XPMultiplier", "Total", "PassSpeed", "TrailMult", "SpeedPct" }) do
    player:GetAttributeChangedSignal(attr):Connect(updateHUD)
end
levelValue:GetPropertyChangedSignal("Value"):Connect(updateHUD)
winsValue:GetPropertyChangedSignal("Value"):Connect(updateHUD)
updateHUD()

-- Estado de los botones de pase (OWNED)
local function refreshPassButtons()
    updatePassSpeed()
    updatePassWins()
end
player:GetAttributeChangedSignal("PassSpeed"):Connect(refreshPassButtons)
player:GetAttributeChangedSignal("PassWins"):Connect(refreshPassButtons)
refreshPassButtons()

-- Puntitos rojos de Daily y FREE
task.spawn(function()
    while true do
        local now = workspace:GetServerTimeNow()
        local dLast = player:GetAttribute("DailyLast") or 0
        local fLast = player:GetAttribute("FreeLast") or 0
        dailyDot.Visible = (dLast == 0) or (now - dLast >= 86400)
        freeDot.Visible = (now - fLast >= Config.Free.Cooldown)
        task.wait(1)
    end
end)

]]></ProtectedString>
