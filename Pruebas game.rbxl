<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454104879AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">AdminPagesA</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Admin = require(script.Parent:WaitForChild("AdminCore"))
local UI = require(script.Parent:WaitForChild("UI"))
 
local new, corner, border = UI.new, UI.corner, UI.border
local makeButton = UI.makeButton
local WHITE, GOLD = UI.WHITE, UI.GOLD
local C = Admin.COLORS
local LINE = Admin.LINE
local GRAYTEXT = Color3.fromRGB(190, 198, 220)
 
------------------------------------------------------------
-- PESTANA: DAR
------------------------------------------------------------
local page = Admin.pages.Dar
 
local group = new("Frame", {
Position = UDim2.fromOffset(282, 14),
Size = UDim2.fromOffset(274, 142),
BackgroundColor3 = Color3.fromRGB(46, 50, 63),
}, page)
corner(group, 12)
border(group, LINE, 3)
 
Admin.makeLabel(group, "Opciones del jugador", UDim2.fromOffset(250, 22), UDim2.fromOffset(12, 6), 18, GOLD)
local targetBox = Admin.makeBox(group, "Usuario... (yo / todos)", UDim2.fromOffset(250, 38), UDim2.fromOffset(12, 34))
local amountBox = Admin.makeBox(group, "Cantidad (ej: 1000)", UDim2.fromOffset(250, 38), UDim2.fromOffset(12, 82))
 
Admin.makeLabel(page,
"💡 Escribe yo para ti o todos para todo el server. Cantidad negativa = quitar. 1 nivel = +1 de velocidad.",
UDim2.fromOffset(274, 100), UDim2.fromOffset(282, 166), 15, GRAYTEXT)
 
local giveButtons = {
{ text = "⭐ Dar XP", kind = "xp", colors = C.GREEN },
{ text = "⚡ Dar Velocidad", kind = "level", colors = C.GREEN },
{ text = "🏆 Dar Wins", kind = "wins", colors = C.YELLOW },
{ text = "🔄 Dar Renacimientos", kind = "rebirths", colors = C.PURPLE },
{ text = "🗑️ Resetear jugador", kind = "reset", colors = C.RED },
}
 
for i, b in ipairs(giveButtons) do
    local btn, label = makeButton(page, {
    Size = UDim2.fromOffset(250, 42),
    Position = UDim2.fromOffset(141, 35 + 50 * (i - 1)),
    Colors = b.colors, Radius = 12, TextSize = 21, Text = b.text, ZIndex = 3,
    })
 
    local armed = false
    btn.MouseButton1Click:Connect(function()
        if b.kind == "reset" then
            if not armed then
                armed = true
                label.Text = "⚠️ ¿Seguro? Toca otra vez"
                task.delay(3, function()
                    armed = false
                    label.Text = b.text
                end)
                return
            end
            armed = false
            label.Text = b.text
        end
        Admin.request("give", { target = targetBox.Text, kind = b.kind, amount = amountBox.Text })
    end)
end
 
------------------------------------------------------------
-- PESTANA: TAGS
------------------------------------------------------------
local tagPage = Admin.pages.Tags
 
local tTarget = Admin.makeBox(tagPage, "Usuario... (yo / todos)", UDim2.fromOffset(260, 38), UDim2.fromOffset(16, 14))
local tText = Admin.makeBox(tagPage, "Texto del tag (ej: VIP)", UDim2.fromOffset(260, 38), UDim2.fromOffset(16, 60))
 
Admin.makeLabel(tagPage, "Color", UDim2.fromOffset(260, 22), UDim2.fromOffset(16, 108), 18, GOLD)
 
local palette = {
Color3.fromRGB(255, 70, 70),
Color3.fromRGB(255, 150, 40),
Color3.fromRGB(255, 215, 60),
Color3.fromRGB(70, 220, 100),
Color3.fromRGB(60, 210, 230),
Color3.fromRGB(70, 130, 255),
Color3.fromRGB(170, 90, 255),
Color3.fromRGB(255, 100, 200),
}
local selectedColor = palette[1]
 
local previewFrame = new("Frame", {
Position = UDim2.fromOffset(312, 14),
Size = UDim2.fromOffset(244, 76),
BackgroundColor3 = Color3.fromRGB(30, 34, 44),
}, tagPage)
corner(previewFrame, 12)
border(previewFrame, LINE, 3)
 
local function updatePreview()
    for _, c in ipairs(previewFrame:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    local text = tText.Text ~= "" and tText.Text or "VIP"
    Admin.makePill(previewFrame, text, selectedColor, 32)
end
tText:GetPropertyChangedSignal("Text"):Connect(updatePreview)
 
local swatches = {}
local function updateSwatches()
    for i, s in ipairs(swatches) do
        local sel = palette[i] == selectedColor
        s.stroke.Color = sel and WHITE or LINE
        s.stroke.Thickness = sel and 4 or 3
        s.scale.Scale = sel and 1.18 or 1
    end
end
 
for i, color in ipairs(palette) do
    local sw = new("TextButton", {
    Position = UDim2.fromOffset(16 + 33 * (i - 1), 136),
    Size = UDim2.fromOffset(28, 28),
    BackgroundColor3 = color,
    Text = "",
    AutoButtonColor = false,
    }, tagPage)
    corner(sw, 14)
    local stroke = border(sw, LINE, 3)
    local scale = new("UIScale", { Scale = 1 }, sw)
    swatches[i] = { stroke = stroke, scale = scale }
    sw.MouseButton1Click:Connect(function()
        selectedColor = color
        updateSwatches()
        updatePreview()
    end)
end
updateSwatches()
updatePreview()
 
Admin.makeLabel(tagPage,
"💡 Quitar este tag borra el que tenga el texto escrito. Máximo 4 tags por jugador.",
UDim2.fromOffset(260, 70), UDim2.fromOffset(16, 184), 15, GRAYTEXT)
 
local function colorPayload()
    return {
    math.floor(selectedColor.R * 255 + 0.5),
    math.floor(selectedColor.G * 255 + 0.5),
    math.floor(selectedColor.B * 255 + 0.5),
    }
end
 
local giveTag = makeButton(tagPage, {
Size = UDim2.fromOffset(244, 44), Position = UDim2.fromOffset(434, 124),
Colors = C.GREEN, Radius = 12, TextSize = 21, Text = "✅ Dar tag", ZIndex = 3,
})
giveTag.MouseButton1Click:Connect(function()
    Admin.request("tag_give", { target = tTarget.Text, text = tText.Text, color = colorPayload() })
end)
 
local removeTag = makeButton(tagPage, {
Size = UDim2.fromOffset(244, 44), Position = UDim2.fromOffset(434, 178),
Colors = C.ORANGE, Radius = 12, TextSize = 21, Text = "➖ Quitar este tag", ZIndex = 3,
})
removeTag.MouseButton1Click:Connect(function()
    if tText.Text == "" then
        Admin.request("tag_remove", { target = tTarget.Text, text = "" })
        return
    end
    Admin.request("tag_remove", { target = tTarget.Text, text = tText.Text })
end)
 
local removeAll = makeButton(tagPage, {
Size = UDim2.fromOffset(244, 44), Position = UDim2.fromOffset(434, 232),
Colors = C.RED, Radius = 12, TextSize = 21, Text = "🗑️ Quitar todos", ZIndex = 3,
})
removeAll.MouseButton1Click:Connect(function()
    Admin.request("tag_remove", { target = tTarget.Text, text = "" })
end)

]]></ProtectedString>
