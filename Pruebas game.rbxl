<Item class="Script" referent="RBX66C1625455D04AC580D8101875513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local partCaida = script.Parent

local function onTouch(otherPart)
    -- Verificamos si lo que tocó la parte es un personaje (jugador)
    local character = otherPart.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if humanoid then
        -- Buscamos la parte "Start" en el Workspace
        local startPart = workspace:FindFirstChild("Start")
        
        if startPart then
            -- Movemos la raíz del personaje (HumanoidRootPart) a la posición de Start
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                -- Sumamos un pequeño espacio hacia arriba para que no aparezca dentro del suelo
                rootPart.CFrame = startPart.CFrame + Vector3.new(0, 5, 0)
            end
        else
            warn("No se encontró ninguna parte llamada 'Start' en el Workspace.")
        end
    end
end

partCaida.Touched:Connect(onTouch)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8018760041fa</UniqueId>
