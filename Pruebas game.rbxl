<string name="Name">MessageBubble</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

local Bubble = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

local function toColor(t, default)
    if type(t) == "table" then
        local r, g, b = tonumber(t[1]), tonumber(t[2]), tonumber(t[3])
        if r and g and b then
            return Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255))
        end
    end
    return default
end

local function luminance(c)
    return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

local function make(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do
        o[k] = v
    end
    o.Parent = parent
    return o
end

function Bubble.new(parent, width)
    local group = make("CanvasGroup", {
    Size = UDim2.fromOffset(width or 540, 96),
    BackgroundColor3 = WHITE,
    }, parent)
    make("UICorner", { CornerRadius = UDim.new(0, 22) }, group)
    local grad = make("UIGradient", { Rotation = 90 }, group)
    local stroke = make("UIStroke", { Thickness = 4 }, group)
    
    -- Foto de quien lo escribio
    local avatar = make("ImageLabel", {
    Position = UDim2.fromOffset(16, 18),
    Size = UDim2.fromOffset(60, 60),
    BackgroundColor3 = WHITE,
    BackgroundTransparency = 0.3,
    Image = "",
    }, group)
    make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, avatar)
    make("UIStroke", { Color = WHITE, Thickness = 3 }, avatar)
    
    -- Nombre
    local nameLabel = make("TextLabel", {
    BackgroundTransparency = 1,
    Position = UDim2.fromOffset(92, 8),
    Size = UDim2.new(1, -108, 0, 22),
    Font = Enum.Font.FredokaOne,
    TextSize = 17,
    TextXAlignment = Enum.TextXAlignment.Left,
    TextTruncate = Enum.TextTruncate.AtEnd,
    Text = "",
    }, group)
    local nameStroke = make("UIStroke", { Thickness = 2 }, nameLabel)
    
    -- Texto del mensaje
    local body = make("TextLabel", {
    BackgroundTransparency = 1,
    Position = UDim2.fromOffset(92, 30),
    Size = UDim2.new(1, -108, 0, 58),
    TextXAlignment = Enum.TextXAlignment.Left,
    TextYAlignment = Enum.TextYAlignment.Top,
    TextWrapped = true,
    TextScaled = true,
    Text = "",
    }, group)
    make("UITextSizeConstraint", { MaxTextSize = 22, MinTextSize = 12 }, body)
    local bodyStroke = make("UIStroke", { Thickness = 2 }, body)
    
    local self = { group = group }
    local lastUser
    
    function self.set(data)
        local bg = toColor(data.bg, Color3.fromRGB(110, 70, 220))
        local tc = toColor(data.textColor, WHITE)
        
        grad.Color = ColorSequence.new(bg:Lerp(WHITE, 0.2), bg:Lerp(BLACK, 0.25))
        stroke.Color = bg:Lerp(BLACK, 0.55)
        
        nameLabel.Text = "📢 " .. tostring(data.name or "")
        nameLabel.TextColor3 = tc
        body.Text = tostring(data.text or "")
        body.TextColor3 = tc
        
        local ok, font = pcall(function()
            return Enum.Font[data.font or "FredokaOne"]
        end)
        body.Font = ok and font or Enum.Font.FredokaOne
        
        -- Contorno del texto (si el texto es oscuro no se usa)
        local thickness = luminance(tc) < 0.4 and 0 or 2
        local strokeColor = bg:Lerp(BLACK, 0.6)
        nameStroke.Color = strokeColor
        bodyStroke.Color = strokeColor
        nameStroke.Thickness = thickness
        bodyStroke.Thickness = thickness
        
        -- Foto del que lo escribio
        local userId = tonumber(data.userId)
        if userId and userId ~= lastUser then
            lastUser = userId
            task.spawn(function()
                local success, content = pcall(function()
                    return Players:GetUserThumbnailAsync(
                    userId,
                    Enum.ThumbnailType.HeadShot,
                    Enum.ThumbnailSize.Size100x100
                    )
                end)
                if success and lastUser == userId then
                    avatar.Image = content
                end
            end)
        end
    end
    
    return self
end

return Bubble

]]></ProtectedString>
