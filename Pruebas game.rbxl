<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UI = require(script.Parent:WaitForChild("UI"))
 
local player = Players.LocalPlayer
local levelValue = player:WaitForChild("leaderstats"):WaitForChild("Level")
 
local rebirthRemote = ReplicatedStorage:WaitForChild("Rebirth")
local skipRemote = ReplicatedStorage:WaitForChild("SkipRebirth")
 
local new, tween, corner, border = UI.new, UI.tween, UI.corner, UI.border
local textStroke, gradient, makeButton = UI.textStroke, UI.gradient, UI.makeButton
local NAVY, WHITE, FONT, COLORS = UI.NAVY, UI.WHITE, UI.FONT, UI.COLORS
local root = UI.root
 
local rebirthIcon = root:WaitForChild("Side"):WaitForChild("RebirthHolder"):WaitForChild("RebirthIcon")
 
local alertDot = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.new(1, -4, 0, 4),
Size = UDim2.fromOffset(26, 26),
BackgroundColor3 = Color3.fromRGB(255, 60, 60),
Visible = false, ZIndex = 5,
}, rebirthIcon)
corner(alertDot, 13)
border(alertDot, WHITE, 3)
new("TextLabel", {
Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
Font = FONT, TextSize = 18, TextColor3 = WHITE, Text = "!", ZIndex = 6,
}, alertDot)
 
local panel = new("Frame", {
Name = "RebirthPanel",
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromScale(0.5, 0.46),
Size = UDim2.fromOffset(620, 410),
BackgroundColor3 = Color3.fromRGB(240, 248, 255),
Visible = false,
}, root)
corner(panel, 30)
border(panel, NAVY, 5)
local panelScale = new("UIScale", { Scale = 1 }, panel)
 
local inner = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromScale(0.5, 0.5),
Size = UDim2.new(1, -18, 1, -18),
BackgroundColor3 = WHITE, ZIndex = 2,
}, panel)
corner(inner, 24)
gradient(inner, { Color3.fromRGB(75, 175, 255), Color3.fromRGB(25, 105, 225) })
border(inner, NAVY, 3)
 
local title = new("TextLabel", {
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.new(0.5, 0, 0, 20),
Size = UDim2.fromOffset(520, 70),
BackgroundTransparency = 1,
Font = UI.TITLE_FONT, TextSize = 54, TextColor3 = WHITE,
Text = "RENACIMIENTO", ZIndex = 6,
}, panel)
textStroke(title, NAVY, 6)
 
local closeBtn = makeButton(panel, {
Name = "Close",
Size = UDim2.fromOffset(46, 46),
Position = UDim2.new(1, -10, 0, 12),
Colors = COLORS.RED, Radius = 12, TextSize = 30, Text = "X", ZIndex = 7,
})
 
local needBadge = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.new(0.5, 0, 0, 96),
Size = UDim2.fromOffset(230, 48),
BackgroundColor3 = WHITE, ZIndex = 3,
}, panel)
corner(needBadge, 14)
border(needBadge, Color3.fromRGB(140, 80, 0), 4)
gradient(needBadge, COLORS.YELLOW)
local needText = new("TextLabel", {
Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
Font = FONT, TextSize = 30, TextColor3 = WHITE, Text = "NIVEL 50", ZIndex = 4,
}, needBadge)
textStroke(needText, Color3.fromRGB(130, 65, 0), 3)
 
local function infoBox(x, colors)
    local box = new("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.new(0.5, x, 0, 172),
    Size = UDim2.fromOffset(210, 76),
    BackgroundColor3 = WHITE, ZIndex = 3,
    }, panel)
    corner(box, 16)
    border(box, NAVY, 4)
    gradient(box, colors)
    local label = new("TextLabel", {
    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
    Font = FONT, TextSize = 20, TextColor3 = WHITE,
    RichText = true, Text = "", ZIndex = 4,
    }, box)
    textStroke(label, NAVY, 3)
    return label
end
 
local beforeLabel = infoBox(-150, { Color3.fromRGB(215, 235, 255), Color3.fromRGB(140, 185, 240) })
local afterLabel = infoBox(150, { Color3.fromRGB(190, 255, 150), Color3.fromRGB(80, 205, 75) })
 
local arrow = new("TextLabel", {
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.new(0.5, 0, 0, 172),
Size = UDim2.fromOffset(60, 60),
BackgroundTransparency = 1,
Font = FONT, TextSize = 44, TextColor3 = WHITE,
Text = "▶", ZIndex = 4,
}, panel)
textStroke(arrow, NAVY, 4)
 
local desc = new("TextLabel", {
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.new(0.5, 0, 0, 236),
Size = UDim2.fromOffset(540, 44),
BackgroundTransparency = 1,
Font = FONT, TextSize = 19, TextColor3 = WHITE,
TextWrapped = true, ZIndex = 3,
Text = "¡Renacer reinicia tu nivel y aumenta tus ganancias de XP!",
}, panel)
textStroke(desc, NAVY, 3)
 
local progBg = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.new(0.5, 0, 0, 284),
Size = UDim2.fromOffset(540, 36),
BackgroundColor3 = Color3.fromRGB(20, 28, 62), ZIndex = 3,
}, panel)
corner(progBg, 18)
border(progBg, NAVY, 4)
local progTrack = new("Frame", {
Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 1, -8),
BackgroundTransparency = 1,
}, progBg)
local progFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, ZIndex = 4 }, progTrack)
corner(progFill, 14)
gradient(progFill, { Color3.fromRGB(110, 225, 255), Color3.fromRGB(20, 150, 240) })
local progText = new("TextLabel", {
Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
Font = FONT, TextSize = 20, TextColor3 = WHITE, ZIndex = 5, Text = "",
}, progBg)
textStroke(progText, NAVY, 3)
 
local rebirthBtn, rebirthBtnLabel, rebirthBtnGrad = makeButton(panel, {
Name = "RebirthBtn",
Size = UDim2.fromOffset(250, 68),
Position = UDim2.new(0.5, -140, 0, 352),
Colors = COLORS.RED, Radius = 16, TextSize = 24, ZIndex = 4,
})
local skipBtn = makeButton(panel, {
Name = "SkipBtn",
Size = UDim2.fromOffset(250, 68),
Position = UDim2.new(0.5, 140, 0, 352),
Colors = COLORS.GREEN, Radius = 16, TextSize = 24, ZIndex = 4,
Text = 'SALTAR\nRENACIMIENTO',
})
 
local function updateRebirth()
    local level = levelValue.Value
    local need = player:GetAttribute("RebirthNeeded") or 50
    local mult = player:GetAttribute("XPMultiplier") or 1
    local nextMult = player:GetAttribute("NextXPMultiplier") or 1.5
 
    needText.Text = "NIVEL " .. need
    beforeLabel.Text = 'ANTES\nx' .. UI.fmtMult(mult) .. " XP"
    afterLabel.Text = 'DESPUÉS\nx' .. UI.fmtMult(nextMult) .. " XP"
    progFill.Size = UDim2.fromScale(math.clamp(level / need, 0, 1), 1)
    progText.Text = "NIVEL " .. level .. " / " .. need
 
    if level >= need then
        rebirthBtnGrad.Color = ColorSequence.new(COLORS.GREEN[1], COLORS.GREEN[2])
        rebirthBtnLabel.Text = 'RENACER\n¡Listo para renacer!'
        alertDot.Visible = true
    else
        rebirthBtnGrad.Color = ColorSequence.new(COLORS.RED[1], COLORS.RED[2])
        rebirthBtnLabel.Text = '🔒 RENACER\nNecesitas nivel ' .. need .. ""
        alertDot.Visible = false
    end
end
 
for _, attr in ipairs({ "RebirthNeeded", "XPMultiplier", "NextXPMultiplier" }) do
    player:GetAttributeChangedSignal(attr):Connect(updateRebirth)
end
levelValue:GetPropertyChangedSignal("Value"):Connect(updateRebirth)
updateRebirth()
 
local panelOpen = false
 
local function openPanel()
    panelOpen = true
    updateRebirth()
    panelScale.Scale = 0.7
    panel.Visible = true
    tween(panelScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
end
 
local function closePanel()
    panelOpen = false
    tween(panelScale, 0.15, { Scale = 0.7 })
    task.delay(0.15, function()
        if not panelOpen then panel.Visible = false end
    end)
end
 
rebirthIcon.MouseButton1Click:Connect(function()
    if panelOpen then closePanel() else openPanel() end
end)
closeBtn.MouseButton1Click:Connect(closePanel)
 
local function shake(obj)
    local origin = obj.Position
    task.spawn(function()
        for _ = 1, 3 do
            tween(obj, 0.04, { Position = origin + UDim2.fromOffset(8, 0) })
            task.wait(0.04)
            tween(obj, 0.04, { Position = origin - UDim2.fromOffset(8, 0) })
            task.wait(0.04)
        end
        obj.Position = origin
    end)
end
 
rebirthBtn.MouseButton1Click:Connect(function()
    local need = player:GetAttribute("RebirthNeeded") or 50
    if levelValue.Value >= need then
        rebirthRemote:FireServer()
        closePanel()
    else
        shake(rebirthBtn)
        UI.showToast("Necesitas nivel " .. need .. " para renacer")
    end
end)
 
skipBtn.MouseButton1Click:Connect(function()
    skipRemote:FireServer()
end)

]]></ProtectedString>
